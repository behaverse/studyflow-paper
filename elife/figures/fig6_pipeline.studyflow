id: fig6_pipeline
definitions:
  targetNamespace: http://bpmn.io/schema/bpmn
  xmlns:xsi: http://www.w3.org/2001/XMLSchema-instance
  xmlns:bpmn2: http://www.omg.org/spec/BPMN/20100524/MODEL
  xmlns:bpmndi: http://www.omg.org/spec/BPMN/20100524/DI
  xmlns:dc: http://www.omg.org/spec/DD/20100524/DC
  xmlns:di: http://www.omg.org/spec/DD/20100524/DI
  xmlns:studyflow: http://behaverse.org/schemas/studyflow/v1
  xmlns:cognitive: http://behaverse.org/schemas/studyflow/cognitive
  xmlns:datatrove: https://w3id.org/studyflow/datatrove
Analysis_Pipeline:
  type: bpmn:Process
  extensionElements:
    - type: studyflow:Study
  name: Analysis pipeline
  documentation: >-
    Figure 6: the analysis pipeline as typed data-operation nodes. read the raw trials; filter invalid trials; map each
    trial to derived measures; branch at an exclusive gateway; reduce to per-run summaries then to group statistics; and
    render and write, after a visible manual outlier review. A BDM trials dataset feeds Read; a results dataset receives
    Render and write.
  flowElements:
    trials_bdm:
      type: bpmn:DataStoreReference
      extensionElements:
        - type: studyflow:Dataset
          catalog: behaverse
          format: bdm
          bdmDataLevel: trials
      name: Trials (BDM)
      bounds:
        x: 529
        "y": 115
        width: 72
        height: 14
    Read:
      type: bpmn:ServiceTask
      extensionElements:
        - type: datatrove:Reader
          className: ParquetReader
      name: Read raw trials
      isDataOperation: true
      uses: python://behaverse_analysis.read_trials@1.0
      bounds:
        x: 340
        "y": 120
        width: 120
        height: 80
      properties:
        Prop_da_read:
          name: __targetRef_placeholder
      dataInputAssociations:
        da_read:
          sourceRef:
            - trials_bdm
          targetRef: Prop_da_read
          waypoint:
            - x: 540
              "y": 85
            - x: 460
              "y": 160
    Filter:
      type: bpmn:ServiceTask
      extensionElements:
        - type: datatrove:Filter
      name: Filter invalid trials (analysis exclusion)
      isDataOperation: true
      uses: python://behaverse_analysis.filter_invalid@1.0
      bounds:
        x: 340
        "y": 220
        width: 120
        height: 80
    Map:
      type: bpmn:ServiceTask
      extensionElements:
        - type: datatrove:Map
      name: Map to derived measures
      isDataOperation: true
      uses: python://behaverse_analysis.derive_measures@1.0
      bounds:
        x: 340
        "y": 320
        width: 120
        height: 80
    Branch:
      type: bpmn:ExclusiveGateway
      name: Branch by comparison
      bounds:
        x: 340
        "y": 475
        width: 120
        height: 14
      isMarkerVisible: true
    ReduceRun:
      type: bpmn:ServiceTask
      extensionElements:
        - type: datatrove:Reduce
      name: Reduce to per-run summaries
      isDataOperation: true
      uses: python://behaverse_analysis.summarize_runs@1.0
      bounds:
        x: 340
        "y": 520
        width: 120
        height: 80
    ReduceGroup:
      type: bpmn:ServiceTask
      extensionElements:
        - type: datatrove:Reduce
      name: Reduce to group statistics (marker, agreement)
      isDataOperation: true
      uses: python://behaverse_analysis.group_stats@1.0
      bounds:
        x: 340
        "y": 620
        width: 120
        height: 80
    ManualReview:
      type: bpmn:UserTask
      name: Manual outlier review
      bounds:
        x: 340
        "y": 720
        width: 120
        height: 80
    Render:
      type: bpmn:ServiceTask
      extensionElements:
        - type: datatrove:Writer
          className: ParquetWriter
      name: Render and write report
      isDataOperation: true
      uses: python://behaverse_analysis.render_report@1.0
      bounds:
        x: 340
        "y": 820
        width: 120
        height: 80
      dataOutputAssociations:
        da_write:
          targetRef: results
          waypoint:
            - x: 460
              "y": 860
            - x: 540
              "y": 865
    results:
      type: bpmn:DataStoreReference
      extensionElements:
        - type: studyflow:Dataset
          catalog: behaverse
          format: bdm
          bdmDataLevel: models
      name: Summaries and statistics (BDM)
      bounds:
        x: 544
        "y": 895
        width: 42
        height: 14
    p1:
      type: bpmn:SequenceFlow
      sourceRef: Read
      targetRef: Filter
      waypoint:
        - x: 400
          "y": 200
        - x: 400
          "y": 220
    p2:
      type: bpmn:SequenceFlow
      sourceRef: Filter
      targetRef: Map
      waypoint:
        - x: 400
          "y": 300
        - x: 400
          "y": 320
    p3:
      type: bpmn:SequenceFlow
      sourceRef: Map
      targetRef: Branch
      waypoint:
        - x: 400
          "y": 400
        - x: 400
          "y": 420
    p4:
      type: bpmn:SequenceFlow
      sourceRef: Branch
      targetRef: ReduceRun
      name: per comparison
      waypoint:
        - x: 400
          "y": 470
        - x: 400
          "y": 520
      label:
        bounds:
          x: 358
          "y": 477
          width: 84
          height: 14
    p5:
      type: bpmn:SequenceFlow
      sourceRef: ReduceRun
      targetRef: ReduceGroup
      waypoint:
        - x: 400
          "y": 600
        - x: 400
          "y": 620
    p6:
      type: bpmn:SequenceFlow
      sourceRef: ReduceGroup
      targetRef: ManualReview
      waypoint:
        - x: 400
          "y": 700
        - x: 400
          "y": 720
    p7:
      type: bpmn:SequenceFlow
      sourceRef: ManualReview
      targetRef: Render
      waypoint:
        - x: 400
          "y": 800
        - x: 400
          "y": 820
  isExecutable: false
