id: cognitive_study
definitions:
  targetNamespace: http://bpmn.io/schema/bpmn
  xmlns:xsi: http://www.w3.org/2001/XMLSchema-instance
  xmlns:bpmn2: http://www.omg.org/spec/BPMN/20100524/MODEL
  xmlns:bpmndi: http://www.omg.org/spec/BPMN/20100524/DI
  xmlns:dc: http://www.omg.org/spec/DD/20100524/DC
  xmlns:di: http://www.omg.org/spec/DD/20100524/DI
  xmlns:bioc: http://bpmn.io/schema/bpmn/biocolor/1.0
  xmlns:color: http://www.omg.org/spec/BPMN/non-normative/color/1.0
  xmlns:studyflow: http://behaverse.org/schemas/studyflow/v1
  xmlns:cognitive: http://behaverse.org/schemas/studyflow/cognitive
  xmlns:behaverse: http://behaverse.org/schemas/studyflow/behaverse
CognitiveStudy:
  type: bpmn:Process
  extensionElements:
    - type: studyflow:Study
  name: Full Cognitive Study
  flowElements:
    Start:
      type: bpmn:StartEvent
      name: Enrollment
      outgoing:
        - Flow_Start_Screening
      consentFormUri: https://example.org/protocols/cognitive-study/consent.pdf
      bounds:
        x: 152
        "y": 222
        width: 36
        height: 36
      label:
        bounds:
          x: 144
          "y": 265
          width: 55
          height: 14
    Screening:
      type: bpmn:Task
      extensionElements:
        - type: cognitive:Questionnaire
          instrument: screening
      checklist: |-
        - [ ] Demographic intake
        - [ ] Medical history
        - [ ] Inclusion/exclusion criteria
        - [ ] Baseline cognitive screen
      name: Screening
      incoming:
        - Flow_Start_Screening
      outgoing:
        - Flow_Screening_Eligibility
      bounds:
        x: 240
        "y": 200
        width: 100
        height: 80
    Eligibility_Gateway:
      type: bpmn:ExclusiveGateway
      extensionElements:
        - type: cognitive:EligibilityGateway
      name: Assessed for eligibility
      incoming:
        - Flow_Screening_Eligibility
      outgoing:
        - Flow_Eligible
        - Flow_NotEligible
      bounds:
        x: 400
        "y": 215
        width: 50
        height: 50
      isMarkerVisible: true
      label:
        bounds:
          x: 385
          "y": 185
          width: 82
          height: 27
    Excluded_Pre:
      type: bpmn:EndEvent
      name: Excluded (n=...)
      incoming:
        - Flow_NotEligible
      eventDefinitions:
        ErrorDef_ExcludedPre:
          type: bpmn:ErrorEventDefinition
      bounds:
        x: 407
        "y": 350
        width: 36
        height: 36
      label:
        bounds:
          x: 397
          "y": 393
          width: 56
          height: 14
      stroke: "#ac5a54"
      fill: "#f1d0cd"
      background-color: "#f1d0cd"
      border-color: "#ac5a54"
    PHQ9:
      type: bpmn:Task
      extensionElements:
        - type: cognitive:Questionnaire
          instrument: phq-9
      name: PHQ-9
      incoming:
        - Flow_Eligible
      outgoing:
        - Flow_PHQ9_GAD7
      bounds:
        x: 510
        "y": 200
        width: 100
        height: 80
    GAD7:
      type: bpmn:Task
      extensionElements:
        - type: cognitive:Questionnaire
          instrument: gad-7
      name: GAD-7
      incoming:
        - Flow_PHQ9_GAD7
      outgoing:
        - Flow_GAD7_Randomize
      bounds:
        x: 670
        "y": 200
        width: 100
        height: 80
    Randomize_Gateway:
      type: bpmn:ExclusiveGateway
      extensionElements:
        - type: cognitive:RandomGateway
      name: Randomization
      incoming:
        - Flow_GAD7_Randomize
      outgoing:
        - Flow_Group_A
        - Flow_Group_B
      bounds:
        x: 830
        "y": 215
        width: 50
        height: 50
      isMarkerVisible: true
      label:
        bounds:
          x: 824
          "y": 271
          width: 62
          height: 14
    Allocate_A:
      type: bpmn:Task
      extensionElements:
        - type: cognitive:Instruction
          content: |-
            # Group A

            You will complete the tasks at your own pace. Take as long as you need on each trial.
      checklist: |-
        - [ ] Allocation concealed until enrollment
        - [ ] Condition recorded in trials table
      name: Group A (self-paced)
      incoming:
        - Flow_Group_A
      outgoing:
        - Flow_A_Merge
      bounds:
        x: 940
        "y": 100
        width: 100
        height: 80
    Allocate_B:
      type: bpmn:Task
      extensionElements:
        - type: cognitive:Instruction
          content: |-
            # Group B

            You will complete the tasks under time pressure. Respond as quickly as you can while staying accurate.
      checklist: |-
        - [ ] Allocation concealed until enrollment
        - [ ] Condition recorded in trials table
      name: Group B (time-pressured)
      incoming:
        - Flow_Group_B
      outgoing:
        - Flow_B_Merge
      bounds:
        x: 940
        "y": 300
        width: 100
        height: 80
    Merge_Gateway:
      type: bpmn:ExclusiveGateway
      name: Begin battery
      incoming:
        - Flow_A_Merge
        - Flow_B_Merge
      outgoing:
        - Flow_Merge_Battery
      bounds:
        x: 1110
        "y": 215
        width: 50
        height: 50
      isMarkerVisible: true
      label:
        bounds:
          x: 1102
          "y": 271
          width: 66
          height: 14
    Battery:
      type: bpmn:SubProcess
      name: Cognitive battery (6 tasks)
      incoming:
        - Flow_Merge_Battery
      outgoing:
        - Flow_Battery_Analysis
      dataOutputAssociations:
        DataOutput_RawTrials:
          targetRef: RawTrials
          waypoint:
            - x: 1230
              "y": 280
            - x: 1140
              "y": 280
            - x: 1140
              "y": 350
      flowElements:
        B_Start:
          type: bpmn:StartEvent
          name: Start
          outgoing:
            - Flow_B_Start_NB
        Task_NB:
          type: bpmn:Task
          extensionElements:
            - type: behaverse:Task
              configurations:
                Blocks:
                  Study_NBack:
                    Name: Study_NBack
                    Inherits: Default
                    Parameters:
                      NValue: 2
                      Feature: Letters
                      Streams:
                        - Feature:
                            Reference: Feature
                          StimulusValue:
                            Generate: OncePerBlock
                            Sequence:
                              Type: Ordered
                              Values:
                                - 3
                                - 1
                                - 2
                                - 1
                                - 3
                                - 2
                                - 3
                                - 2
                                - 1
                                - 2
                                - 3
                                - 1
                      StreamSize: 12
                      FeatureValuesCount: 3
                      StimulusDisplayDuration: 0.5
                      InterStimulusInterval: 1.5
                Timelines:
                  Study_NBack:
                    Name: Study_NBack
                    blocks:
                      - name: Study_NBack
              scene: NB
              agentType: bot
              botConfigurations:
                ResponseSource: llm
                LLM:
                  Provider: ollama
                  Model: gemma4:e2b-mlx
                Prompt: |
                  You are an attentive, expert participant aiming for high accuracy.
                  In this 2-back task, reply Match if the current letter is identical to the
                  letter shown two trials ago, otherwise NonMatch. Reply with exactly Match
                  or NonMatch; no explanation.
                Speed: 20
                SkipInstructions: true
                AutoClickInstructions: true
                SkipFocusArea: true
                OverrideTemporalParameters: true
                StimulusDisplayDuration: 0.5
                InterStimulusInterval: 1.5
                useNonMatchButton: true
                maxResponseTime: 15
              configMode: inline
          name: |-
            N-back
            (text)
          incoming:
            - Flow_B_Start_NB
          outgoing:
            - Flow_NB_DS
        Task_DS:
          type: bpmn:Task
          extensionElements:
            - type: behaverse:Task
              scene: DS
              agentType: bot
              botConfigurations:
                ResponseSource: llm
                LLM:
                  Provider: ollama
                  Model: gemma4:e2b-mlx
                Prompt: |
                  You are an attentive, expert participant aiming for high accuracy.
                  In this digit-span task, after the digits are shown, reproduce them in the
                  order presented. Reply with the digits separated by spaces; nothing else.
                Speed: 20
                SkipInstructions: true
                AutoClickInstructions: true
                SkipFocusArea: true
                maxResponseTime: 30
          name: |-
            Digit span
            (text)
          incoming:
            - Flow_NB_DS
          outgoing:
            - Flow_DS_MOT
        Task_MOT:
          type: bpmn:Task
          extensionElements:
            - type: behaverse:Task
              scene: MOT
              agentType: bot
              botConfigurations:
                ResponseSource: llm
                IncludeScreenshot: true
                LLM:
                  Provider: ollama
                  Model: llava:13b
                Prompt: |
                  You are an attentive, expert participant aiming for high accuracy.
                  You will see a screenshot of a multiple-object tracking display. Identify
                  and select the objects that were cued as targets at the start of the trial.
                  Reply with the positions of the targets you select; nothing else.
                Speed: 5
                SkipInstructions: true
                AutoClickInstructions: true
                SkipFocusArea: true
          name: |-
            Object tracking
            (vision)
          incoming:
            - Flow_DS_MOT
          outgoing:
            - Flow_MOT_PC
        Task_PC:
          type: bpmn:Task
          extensionElements:
            - type: behaverse:Task
              scene: PC
              agentType: bot
              botConfigurations:
                ResponseSource: llm
                IncludeScreenshot: true
                LLM:
                  Provider: ollama
                  Model: llava:13b
                Prompt: |
                  You are an attentive, expert participant aiming for high accuracy.
                  You will see a screenshot of a pattern-comparison trial showing two
                  patterns side by side. Reply Same if they are identical, Different
                  otherwise. Reply with exactly Same or Different.
                Speed: 5
                SkipInstructions: true
                AutoClickInstructions: true
                SkipFocusArea: true
          name: |-
            Pattern comparison
            (vision)
          incoming:
            - Flow_MOT_PC
          outgoing:
            - Flow_PC_BM
        Task_BM:
          type: bpmn:Task
          extensionElements:
            - type: behaverse:Task
              scene: BM
              agentType: bot
              botConfigurations:
                ResponseSource: llm
                IncludeScreenshot: true
                LLM:
                  Provider: ollama
                  Model: llava:13b
                Prompt: |
                  You are an attentive, expert participant aiming for high accuracy.
                  You will see a screenshot of a matrix-reasoning problem with a missing
                  cell and several answer options. Choose the option that completes the
                  pattern. Reply with exactly the option label; nothing else.
                Speed: 5
                SkipInstructions: true
                AutoClickInstructions: true
                SkipFocusArea: true
          name: |-
            Matrix reasoning
            (vision)
          incoming:
            - Flow_PC_BM
          outgoing:
            - Flow_BM_BCS
        Task_BCS:
          type: bpmn:Task
          extensionElements:
            - type: behaverse:Task
              scene: BCS
              agentType: bot
              botConfigurations:
                ResponseSource: llm
                IncludeScreenshot: true
                LLM:
                  Provider: ollama
                  Model: llava:13b
                Prompt: |
                  You are an attentive, expert participant aiming for high accuracy.
                  You will see a screenshot of a card-sorting screen. Sort the card at the
                  bottom onto the matching pile under the current rule, inferring the rule
                  from recent feedback. Reply with the target pile; nothing else.
                Speed: 5
                SkipInstructions: true
                AutoClickInstructions: true
                SkipFocusArea: true
          name: |-
            Card sorting
            (vision)
          incoming:
            - Flow_BM_BCS
          outgoing:
            - Flow_BCS_End
        B_End:
          type: bpmn:EndEvent
          name: Done
          incoming:
            - Flow_BCS_End
        Flow_B_Start_NB:
          type: bpmn:SequenceFlow
          sourceRef: B_Start
          targetRef: Task_NB
        Flow_NB_DS:
          type: bpmn:SequenceFlow
          sourceRef: Task_NB
          targetRef: Task_DS
        Flow_DS_MOT:
          type: bpmn:SequenceFlow
          sourceRef: Task_DS
          targetRef: Task_MOT
        Flow_MOT_PC:
          type: bpmn:SequenceFlow
          sourceRef: Task_MOT
          targetRef: Task_PC
        Flow_PC_BM:
          type: bpmn:SequenceFlow
          sourceRef: Task_PC
          targetRef: Task_BM
        Flow_BM_BCS:
          type: bpmn:SequenceFlow
          sourceRef: Task_BM
          targetRef: Task_BCS
        Flow_BCS_End:
          type: bpmn:SequenceFlow
          sourceRef: Task_BCS
          targetRef: B_End
      bounds:
        x: 1210
        "y": 200
        width: 100
        height: 80
    Dropout:
      type: bpmn:BoundaryEvent
      name: Dropped out (n=...)
      outgoing:
        - Flow_Dropout_Excluded
      eventDefinitions:
        ErrorDef_Dropout:
          type: bpmn:ErrorEventDefinition
      attachedToRef: Battery
      bounds:
        x: 1242
        "y": 262
        width: 36
        height: 36
      label:
        bounds:
          x: 1283
          "y": 269
          width: 66
          height: 27
    Analysis:
      type: bpmn:SubProcess
      checklist: |-
        - [ ] Pre-registered analysis plan applied
        - [ ] Outliers reviewed
        - [ ] Figures reproducible from seed
      name: Analysis and visualization
      incoming:
        - Flow_Battery_Analysis
      outgoing:
        - Flow_Analysis_Complete
      properties:
        Property_Analysis_in:
          name: __targetRef_placeholder
      dataInputAssociations:
        DataInput_RawTrials_Analysis:
          sourceRef:
            - RawTrials
          targetRef: Property_Analysis_in
          waypoint:
            - x: 1165
              "y": 375
            - x: 1450
              "y": 375
            - x: 1450
              "y": 280
      dataOutputAssociations:
        DataOutput_Summary:
          targetRef: Summary
          waypoint:
            - x: 1430
              "y": 280
            - x: 1420
              "y": 350
        DataOutput_Figures:
          targetRef: Figures
          waypoint:
            - x: 1480
              "y": 280
            - x: 1505
              "y": 350
      flowElements:
        A_Start:
          type: bpmn:StartEvent
          name: Start
          outgoing:
            - Flow_A_Start_Read
        A_Read:
          type: bpmn:ServiceTask
          name: Read raw trials
          incoming:
            - Flow_A_Start_Read
          outgoing:
            - Flow_A_Read_Filter
          isDataOperation: true
          studyflow:operationType: transform
        A_Filter:
          type: bpmn:ServiceTask
          name: Filter invalid trials
          incoming:
            - Flow_A_Read_Filter
          outgoing:
            - Flow_A_Filter_Map
          isDataOperation: true
          studyflow:operationType: filter
        A_Map:
          type: bpmn:ServiceTask
          name: Derive log-RT and accuracy
          incoming:
            - Flow_A_Filter_Map
          outgoing:
            - Flow_A_Map_Branch
          isDataOperation: true
          studyflow:operationType: map
        A_Branch:
          type: bpmn:ExclusiveGateway
          name: Design (within / between)
          incoming:
            - Flow_A_Map_Branch
          outgoing:
            - Flow_A_Branch_Within
            - Flow_A_Branch_Between
        A_Group:
          type: bpmn:ServiceTask
          name: Group by task, group, persona
          incoming:
            - Flow_A_Branch_Within
            - Flow_A_Branch_Between
          outgoing:
            - Flow_A_Group_Reduce
          isDataOperation: true
          studyflow:operationType: map
        A_Reduce:
          type: bpmn:ServiceTask
          name: Reduce to accuracy, median RT, SE
          incoming:
            - Flow_A_Group_Reduce
          outgoing:
            - Flow_A_Reduce_Review
          isDataOperation: true
          studyflow:operationType: reduce
        A_Review:
          type: bpmn:UserTask
          name: Manual outlier review
          incoming:
            - Flow_A_Reduce_Review
          outgoing:
            - Flow_A_Review_Viz
        A_Visualize:
          type: bpmn:ScriptTask
          name: Plot accuracy and RT
          incoming:
            - Flow_A_Review_Viz
          outgoing:
            - Flow_A_Viz_Write
          scriptFormat: python
          script: |-
            import seaborn as sns, matplotlib.pyplot as plt
            g = sns.catplot(data=summary, x="task", y="accuracy", hue="group",
                            col="persona", kind="bar")
            g.savefig("figures/accuracy_by_task.png")
            sns.relplot(data=trials, x="task", y="rt_ms", hue="model", kind="line")
            plt.savefig("figures/rt_by_task.png")
        A_Write:
          type: bpmn:ServiceTask
          name: Write summary table
          incoming:
            - Flow_A_Viz_Write
          outgoing:
            - Flow_A_Write_End
          isDataOperation: true
          studyflow:operationType: transform
        A_End:
          type: bpmn:EndEvent
          name: Done
          incoming:
            - Flow_A_Write_End
        Flow_A_Start_Read:
          type: bpmn:SequenceFlow
          sourceRef: A_Start
          targetRef: A_Read
        Flow_A_Read_Filter:
          type: bpmn:SequenceFlow
          sourceRef: A_Read
          targetRef: A_Filter
        Flow_A_Filter_Map:
          type: bpmn:SequenceFlow
          sourceRef: A_Filter
          targetRef: A_Map
        Flow_A_Map_Branch:
          type: bpmn:SequenceFlow
          sourceRef: A_Map
          targetRef: A_Branch
        Flow_A_Branch_Within:
          type: bpmn:SequenceFlow
          name: within-subject
          sourceRef: A_Branch
          targetRef: A_Group
        Flow_A_Branch_Between:
          type: bpmn:SequenceFlow
          name: between-subject
          sourceRef: A_Branch
          targetRef: A_Group
        Flow_A_Group_Reduce:
          type: bpmn:SequenceFlow
          sourceRef: A_Group
          targetRef: A_Reduce
        Flow_A_Reduce_Review:
          type: bpmn:SequenceFlow
          sourceRef: A_Reduce
          targetRef: A_Review
        Flow_A_Review_Viz:
          type: bpmn:SequenceFlow
          sourceRef: A_Review
          targetRef: A_Visualize
        Flow_A_Viz_Write:
          type: bpmn:SequenceFlow
          sourceRef: A_Visualize
          targetRef: A_Write
        Flow_A_Write_End:
          type: bpmn:SequenceFlow
          sourceRef: A_Write
          targetRef: A_End
      bounds:
        x: 1400
        "y": 200
        width: 100
        height: 80
    Complete:
      type: bpmn:EndEvent
      name: Completed
      incoming:
        - Flow_Analysis_Complete
      redirectTo: https://app.prolific.com/submissions/complete?cc={COMPLETION_CODE}
      completionCodeType: dynamic
      bounds:
        x: 1580
        "y": 222
        width: 36
        height: 36
      label:
        bounds:
          x: 1572
          "y": 265
          width: 55
          height: 14
    Excluded_Post:
      type: bpmn:EndEvent
      name: Excluded (n=...)
      incoming:
        - Flow_Dropout_Excluded
      eventDefinitions:
        ErrorDef_ExcludedPost:
          type: bpmn:ErrorEventDefinition
      bounds:
        x: 1242
        "y": 430
        width: 36
        height: 36
      label:
        bounds:
          x: 1232
          "y": 473
          width: 56
          height: 14
      stroke: "#ac5a54"
      fill: "#f1d0cd"
      background-color: "#f1d0cd"
      border-color: "#ac5a54"
    RawTrials:
      type: bpmn:DataStoreReference
      extensionElements:
        - type: studyflow:Dataset
          format: bdm
          bdmDataLevel: trials
      name: Raw trials (BDM)
      bounds:
        x: 1115
        "y": 350
        width: 50
        height: 50
      label:
        bounds:
          x: 1100
          "y": 405
          width: 80
          height: 14
    Summary:
      type: bpmn:DataStoreReference
      extensionElements:
        - type: studyflow:Dataset
          format: bdm
          bdmDataLevel: models
      name: Summary (BDM models)
      bounds:
        x: 1395
        "y": 350
        width: 50
        height: 50
      label:
        bounds:
          x: 1375
          "y": 405
          width: 90
          height: 14
    Figures:
      type: bpmn:DataStoreReference
      extensionElements:
        - type: studyflow:Dataset
      name: Figures
      bounds:
        x: 1485
        "y": 350
        width: 50
        height: 50
      label:
        bounds:
          x: 1490
          "y": 405
          width: 40
          height: 14
    Flow_Start_Screening:
      type: bpmn:SequenceFlow
      sourceRef: Start
      targetRef: Screening
      waypoint:
        - x: 188
          "y": 240
        - x: 240
          "y": 240
    Flow_Screening_Eligibility:
      type: bpmn:SequenceFlow
      sourceRef: Screening
      targetRef: Eligibility_Gateway
      waypoint:
        - x: 340
          "y": 240
        - x: 400
          "y": 240
    Flow_Eligible:
      type: bpmn:SequenceFlow
      name: eligible
      sourceRef: Eligibility_Gateway
      targetRef: PHQ9
      waypoint:
        - x: 450
          "y": 240
        - x: 510
          "y": 240
      label:
        bounds:
          x: 462
          "y": 222
          width: 38
          height: 14
    Flow_NotEligible:
      type: bpmn:SequenceFlow
      name: not eligible
      sourceRef: Eligibility_Gateway
      targetRef: Excluded_Pre
      waypoint:
        - x: 425
          "y": 265
        - x: 425
          "y": 350
      label:
        bounds:
          x: 430
          "y": 300
          width: 60
          height: 14
      stroke: "#ac5a54"
      border-color: "#ac5a54"
    Flow_PHQ9_GAD7:
      type: bpmn:SequenceFlow
      sourceRef: PHQ9
      targetRef: GAD7
      waypoint:
        - x: 610
          "y": 240
        - x: 670
          "y": 240
    Flow_GAD7_Randomize:
      type: bpmn:SequenceFlow
      sourceRef: GAD7
      targetRef: Randomize_Gateway
      waypoint:
        - x: 770
          "y": 240
        - x: 830
          "y": 240
    Flow_Group_A:
      type: bpmn:SequenceFlow
      name: Group A
      sourceRef: Randomize_Gateway
      targetRef: Allocate_A
      waypoint:
        - x: 855
          "y": 215
        - x: 855
          "y": 140
        - x: 940
          "y": 140
      label:
        bounds:
          x: 862
          "y": 123
          width: 50
          height: 14
    Flow_Group_B:
      type: bpmn:SequenceFlow
      name: Group B
      sourceRef: Randomize_Gateway
      targetRef: Allocate_B
      waypoint:
        - x: 855
          "y": 265
        - x: 855
          "y": 340
        - x: 940
          "y": 340
      label:
        bounds:
          x: 862
          "y": 323
          width: 50
          height: 14
    Flow_A_Merge:
      type: bpmn:SequenceFlow
      sourceRef: Allocate_A
      targetRef: Merge_Gateway
      waypoint:
        - x: 1040
          "y": 140
        - x: 1135
          "y": 140
        - x: 1135
          "y": 215
    Flow_B_Merge:
      type: bpmn:SequenceFlow
      sourceRef: Allocate_B
      targetRef: Merge_Gateway
      waypoint:
        - x: 1040
          "y": 340
        - x: 1135
          "y": 340
        - x: 1135
          "y": 265
    Flow_Merge_Battery:
      type: bpmn:SequenceFlow
      sourceRef: Merge_Gateway
      targetRef: Battery
      waypoint:
        - x: 1160
          "y": 240
        - x: 1210
          "y": 240
    Flow_Battery_Analysis:
      type: bpmn:SequenceFlow
      sourceRef: Battery
      targetRef: Analysis
      waypoint:
        - x: 1310
          "y": 240
        - x: 1400
          "y": 240
    Flow_Analysis_Complete:
      type: bpmn:SequenceFlow
      sourceRef: Analysis
      targetRef: Complete
      waypoint:
        - x: 1500
          "y": 240
        - x: 1580
          "y": 240
    Flow_Dropout_Excluded:
      type: bpmn:SequenceFlow
      name: reason
      sourceRef: Dropout
      targetRef: Excluded_Post
      waypoint:
        - x: 1260
          "y": 298
        - x: 1260
          "y": 430
      label:
        bounds:
          x: 1265
          "y": 360
          width: 34
          height: 14
      stroke: "#ac5a54"
