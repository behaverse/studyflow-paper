id: fig3_consort
definitions:
  targetNamespace: http://bpmn.io/schema/bpmn
  xmlns:xsi: http://www.w3.org/2001/XMLSchema-instance
  xmlns:bpmn2: http://www.omg.org/spec/BPMN/20100524/MODEL
  xmlns:bpmndi: http://www.omg.org/spec/BPMN/20100524/DI
  xmlns:dc: http://www.omg.org/spec/DD/20100524/DC
  xmlns:di: http://www.omg.org/spec/DD/20100524/DI
  xmlns:studyflow: http://behaverse.org/schemas/studyflow/v1
  xmlns:cognitive: http://behaverse.org/schemas/studyflow/cognitive
  xmlns:datatrove: https://w3id.org/studyflow/datatrove
  xmlns:bioc: http://bpmn.io/schema/bpmn/biocolor/1.0
  xmlns:color: http://www.omg.org/spec/BPMN/non-normative/color/1.0
CONSORT_Studyflow:
  type: bpmn:Process
  extensionElements:
    - type: studyflow:Study
  name: CONSORT participant flow
  documentation: >-
    Figure 3(b): the example study's participant flow in Studyflow. Attrition is encoded as boundary error events wired
    to counted error end events, so the topology of the published CONSORT flow is the topology the runner executes.
  flowElements:
    Enrolled:
      type: bpmn:StartEvent
      name: Enrolled
      bounds:
        x: 406
        "y": 101
        width: 48
        height: 14
    Screening:
      type: bpmn:Task
      extensionElements:
        - type: cognitive:Questionnaire
          instrument: screening
      name: Screening
      bounds:
        x: 370
        "y": 150
        width: 120
        height: 80
    Screen_fail:
      type: bpmn:BoundaryEvent
      name: screen-out
      attachedToRef: Screening
      eventDefinitions:
        Screen_fail_def:
          type: bpmn:ErrorEventDefinition
      cancelActivity: true
      bounds:
        x: 428
        "y": 253
        width: 60
        height: 14
    Excluded_pre:
      type: bpmn:EndEvent
      name: Excluded (n = ...)
      eventDefinitions:
        Excluded_pre_def:
          type: bpmn:ErrorEventDefinition
      bounds:
        x: 574
        "y": 197
        width: 130
        height: 14
      stroke: "#ac5a54"
      fill: "#f1d0cd"
      background-color: "#f1d0cd"
      border-color: "#ac5a54"
    Randomize:
      type: bpmn:ExclusiveGateway
      extensionElements:
        - type: cognitive:RandomGateway
      name: Randomized
      bounds:
        x: 403
        "y": 355
        width: 54
        height: 14
      isMarkerVisible: true
    SelfPaced:
      type: bpmn:Task
      extensionElements:
        - type: cognitive:CognitiveTask
          instrument: behaverse
      name: Self-paced battery
      bounds:
        x: 180
        "y": 410
        width: 120
        height: 80
    SelfPaced_drop:
      type: bpmn:BoundaryEvent
      name: quit
      attachedToRef: SelfPaced
      eventDefinitions:
        SelfPaced_drop_def:
          type: bpmn:ErrorEventDefinition
      cancelActivity: true
      bounds:
        x: 200
        "y": 513
        width: 24
        height: 14
    TimePressured:
      type: bpmn:Task
      extensionElements:
        - type: cognitive:CognitiveTask
          instrument: behaverse
      name: Speeded battery
      bounds:
        x: 560
        "y": 410
        width: 120
        height: 80
    TimePressured_drop:
      type: bpmn:BoundaryEvent
      name: quit
      attachedToRef: TimePressured
      eventDefinitions:
        TimePressured_drop_def:
          type: bpmn:ErrorEventDefinition
      cancelActivity: true
      bounds:
        x: 636
        "y": 513
        width: 24
        height: 14
    Dropped:
      type: bpmn:EndEvent
      name: Discontinued intervention (n = ...)
      eventDefinitions:
        Dropped_def:
          type: bpmn:ErrorEventDefinition
      bounds:
        x: 367
        "y": 561
        width: 126
        height: 14
      stroke: "#ac5a54"
      fill: "#f1d0cd"
      background-color: "#f1d0cd"
      border-color: "#ac5a54"
    Analyze_A:
      type: bpmn:ServiceTask
      extensionElements:
        - type: datatrove:Reduce
      name: Analyze
      isDataOperation: true
      bounds:
        x: 180
        "y": 560
        width: 120
        height: 80
    Analyze_A_excl:
      type: bpmn:BoundaryEvent
      name: exclude
      attachedToRef: Analyze_A
      eventDefinitions:
        Analyze_A_excl_def:
          type: bpmn:ErrorEventDefinition
      cancelActivity: true
      bounds:
        x: 191
        "y": 663
        width: 42
        height: 14
    Analyze_B:
      type: bpmn:ServiceTask
      extensionElements:
        - type: datatrove:Reduce
      name: Analyze
      isDataOperation: true
      bounds:
        x: 560
        "y": 560
        width: 120
        height: 80
    Analyze_B_excl:
      type: bpmn:BoundaryEvent
      name: exclude
      attachedToRef: Analyze_B
      eventDefinitions:
        Analyze_B_excl_def:
          type: bpmn:ErrorEventDefinition
      cancelActivity: true
      bounds:
        x: 627
        "y": 663
        width: 42
        height: 14
    Excluded_analysis:
      type: bpmn:EndEvent
      name: Excluded from analysis (n = ...)
      eventDefinitions:
        Excluded_analysis_def:
          type: bpmn:ErrorEventDefinition
      bounds:
        x: 365
        "y": 701
        width: 130
        height: 14
      stroke: "#ac5a54"
      fill: "#f1d0cd"
      background-color: "#f1d0cd"
      border-color: "#ac5a54"
    Analyzed:
      type: bpmn:EndEvent
      name: Analyzed (n = ...)
      bounds:
        x: 406
        "y": 741
        width: 48
        height: 14
    f_enr_scr:
      type: bpmn:SequenceFlow
      sourceRef: Enrolled
      targetRef: Screening
      waypoint:
        - x: 430
          "y": 96
        - x: 430
          "y": 150
    f_scr_rand:
      type: bpmn:SequenceFlow
      sourceRef: Screening
      targetRef: Randomize
      waypoint:
        - x: 430
          "y": 230
        - x: 430
          "y": 300
    f_screenfail:
      type: bpmn:SequenceFlow
      sourceRef: Screen_fail
      targetRef: Excluded_pre
      name: reason
      waypoint:
        - x: 476
          "y": 230
        - x: 610
          "y": 174
      label:
        bounds:
          x: 525
          "y": 184
          width: 36
          height: 14
      stroke: "#ac5a54"
      border-color: "#ac5a54"
    f_rand_a:
      type: bpmn:SequenceFlow
      sourceRef: Randomize
      targetRef: SelfPaced
      name: self-paced
      waypoint:
        - x: 405
          "y": 325
        - x: 300
          "y": 450
      label:
        bounds:
          x: 323
          "y": 370
          width: 60
          height: 14
    f_rand_b:
      type: bpmn:SequenceFlow
      sourceRef: Randomize
      targetRef: TimePressured
      name: speeded
      waypoint:
        - x: 455
          "y": 325
        - x: 560
          "y": 450
      label:
        bounds:
          x: 466
          "y": 370
          width: 84
          height: 14
    f_a_drop:
      type: bpmn:SequenceFlow
      sourceRef: SelfPaced_drop
      targetRef: Dropped
      name: reason
      waypoint:
        - x: 230
          "y": 490
        - x: 412
          "y": 538
      label:
        bounds:
          x: 303
          "y": 496
          width: 36
          height: 14
      stroke: "#ac5a54"
      border-color: "#ac5a54"
    f_b_drop:
      type: bpmn:SequenceFlow
      sourceRef: TimePressured_drop
      targetRef: Dropped
      name: reason
      waypoint:
        - x: 630
          "y": 490
        - x: 448
          "y": 538
      label:
        bounds:
          x: 521
          "y": 496
          width: 36
          height: 14
      stroke: "#ac5a54"
      border-color: "#ac5a54"
    f_a_an:
      type: bpmn:SequenceFlow
      sourceRef: SelfPaced
      targetRef: Analyze_A
      waypoint:
        - x: 240
          "y": 490
        - x: 240
          "y": 560
    f_b_an:
      type: bpmn:SequenceFlow
      sourceRef: TimePressured
      targetRef: Analyze_B
      waypoint:
        - x: 620
          "y": 490
        - x: 620
          "y": 560
    f_a_excl:
      type: bpmn:SequenceFlow
      sourceRef: Analyze_A_excl
      targetRef: Excluded_analysis
      waypoint:
        - x: 230
          "y": 640
        - x: 412
          "y": 678
      stroke: "#ac5a54"
      border-color: "#ac5a54"
    f_b_excl:
      type: bpmn:SequenceFlow
      sourceRef: Analyze_B_excl
      targetRef: Excluded_analysis
      waypoint:
        - x: 630
          "y": 640
        - x: 448
          "y": 678
      stroke: "#ac5a54"
      border-color: "#ac5a54"
    f_a_done:
      type: bpmn:SequenceFlow
      sourceRef: Analyze_A
      targetRef: Analyzed
      waypoint:
        - x: 300
          "y": 600
        - x: 412
          "y": 718
    f_b_done:
      type: bpmn:SequenceFlow
      sourceRef: Analyze_B
      targetRef: Analyzed
      waypoint:
        - x: 560
          "y": 600
        - x: 448
          "y": 718
  isExecutable: false
