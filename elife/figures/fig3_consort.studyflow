id: fig3_consort
definitions:
  targetNamespace: http://bpmn.io/schema/bpmn
  xmlns:xsi: http://www.w3.org/2001/XMLSchema-instance
  xmlns:bpmn2: http://www.omg.org/spec/BPMN/20100524/MODEL
  xmlns:bpmndi: http://www.omg.org/spec/BPMN/20100524/DI
  xmlns:dc: http://www.omg.org/spec/DD/20100524/DC
  xmlns:di: http://www.omg.org/spec/DD/20100524/DI
  xmlns:studyflow: http://behaverse.org/schemas/studyflow/v1
  xmlns:cognitive: http://behaverse.org/schemas/studyflow/cognitive
  xmlns:datatrove: https://w3id.org/studyflow/datatrove
  xmlns:bioc: http://bpmn.io/schema/bpmn/biocolor/1.0
  xmlns:color: http://www.omg.org/spec/BPMN/non-normative/color/1.0
CONSORT_Studyflow:
  type: bpmn:Process
  extensionElements:
    - type: studyflow:Study
  name: CONSORT participant flow
  documentation: >-
    Figure 3(b): the example study's participant flow in Studyflow, grouped into
    the four CONSORT 2025 phases (enrolment, allocation, follow-up, analysis).
    Attrition is encoded as boundary error events wired to counted error end
    events, so the topology of the published CONSORT flow is the topology the
    runner executes. The phase bands are bpmn:Group artifacts, a projection
    device that only annotates and never changes the control flow.
  isExecutable: false
  flowElements:

    # ---------- Enrolment ----------
    Enrolled:
      type: bpmn:StartEvent
      name: Enrolled
      bounds:
        x: 432
        "y": 92
        width: 36
        height: 36
      label:
        bounds:
          x: 414
          "y": 74
          width: 72
          height: 14
    Screening:
      type: bpmn:Task
      extensionElements:
        - type: cognitive:Questionnaire
          instrument: screening
      name: Screening
      bounds:
        x: 390
        "y": 170
        width: 120
        height: 80
    Screen_fail:
      type: bpmn:BoundaryEvent
      name: screen-out
      attachedToRef: Screening
      eventDefinitions:
        Screen_fail_def:
          type: bpmn:ErrorEventDefinition
      cancelActivity: true
      bounds:
        x: 492
        "y": 232
        width: 36
        height: 36
      label:
        bounds:
          x: 500
          "y": 270
          width: 68
          height: 14
    Excluded_pre:
      type: bpmn:EndEvent
      name: Excluded (n = ...)
      eventDefinitions:
        Excluded_pre_def:
          type: bpmn:ErrorEventDefinition
      bounds:
        x: 720
        "y": 232
        width: 36
        height: 36
      label:
        bounds:
          x: 690
          "y": 272
          width: 100
          height: 14
      stroke: "#ac5a54"
      fill: "#f1d0cd"
      background-color: "#f1d0cd"
      border-color: "#ac5a54"

    # ---------- Allocation ----------
    Randomize:
      type: bpmn:ExclusiveGateway
      extensionElements:
        - type: cognitive:RandomGateway
      name: Randomized
      bounds:
        x: 425
        "y": 320
        width: 50
        height: 50
      isMarkerVisible: true
      label:
        bounds:
          x: 485
          "y": 333
          width: 78
          height: 14

    # ---------- Follow-up ----------
    SelfPaced:
      type: bpmn:Task
      extensionElements:
        - type: cognitive:CognitiveTask
          instrument: behaverse
      name: Self-paced battery
      bounds:
        x: 240
        "y": 430
        width: 120
        height: 80
    SelfPaced_drop:
      type: bpmn:BoundaryEvent
      name: quit
      attachedToRef: SelfPaced
      eventDefinitions:
        SelfPaced_drop_def:
          type: bpmn:ErrorEventDefinition
      cancelActivity: true
      bounds:
        x: 342
        "y": 492
        width: 36
        height: 36
      label:
        bounds:
          x: 320
          "y": 530
          width: 40
          height: 14
    TimePressured:
      type: bpmn:Task
      extensionElements:
        - type: cognitive:CognitiveTask
          instrument: behaverse
      name: Speeded battery
      bounds:
        x: 540
        "y": 430
        width: 120
        height: 80
    TimePressured_drop:
      type: bpmn:BoundaryEvent
      name: quit
      attachedToRef: TimePressured
      eventDefinitions:
        TimePressured_drop_def:
          type: bpmn:ErrorEventDefinition
      cancelActivity: true
      bounds:
        x: 522
        "y": 492
        width: 36
        height: 36
      label:
        bounds:
          x: 540
          "y": 530
          width: 40
          height: 14
    Dropped:
      type: bpmn:EndEvent
      name: Discontinued intervention (n = ...)
      eventDefinitions:
        Dropped_def:
          type: bpmn:ErrorEventDefinition
      bounds:
        x: 432
        "y": 560
        width: 36
        height: 36
      label:
        bounds:
          x: 380
          "y": 600
          width: 140
          height: 14
      stroke: "#ac5a54"
      fill: "#f1d0cd"
      background-color: "#f1d0cd"
      border-color: "#ac5a54"

    # ---------- Analysis ----------
    Analyze_A:
      type: bpmn:ServiceTask
      extensionElements:
        - type: datatrove:Reduce
      name: Analyze
      isDataOperation: true
      bounds:
        x: 240
        "y": 670
        width: 120
        height: 80
    Analyze_A_excl:
      type: bpmn:BoundaryEvent
      name: exclude
      attachedToRef: Analyze_A
      eventDefinitions:
        Analyze_A_excl_def:
          type: bpmn:ErrorEventDefinition
      cancelActivity: true
      bounds:
        x: 342
        "y": 732
        width: 36
        height: 36
      label:
        bounds:
          x: 316
          "y": 770
          width: 48
          height: 14
    Analyze_B:
      type: bpmn:ServiceTask
      extensionElements:
        - type: datatrove:Reduce
      name: Analyze
      isDataOperation: true
      bounds:
        x: 540
        "y": 670
        width: 120
        height: 80
    Analyze_B_excl:
      type: bpmn:BoundaryEvent
      name: exclude
      attachedToRef: Analyze_B
      eventDefinitions:
        Analyze_B_excl_def:
          type: bpmn:ErrorEventDefinition
      cancelActivity: true
      bounds:
        x: 522
        "y": 732
        width: 36
        height: 36
      label:
        bounds:
          x: 540
          "y": 770
          width: 48
          height: 14
    Excluded_analysis:
      type: bpmn:EndEvent
      name: Excluded from analysis (n = ...)
      eventDefinitions:
        Excluded_analysis_def:
          type: bpmn:ErrorEventDefinition
      bounds:
        x: 432
        "y": 790
        width: 36
        height: 36
      label:
        bounds:
          x: 380
          "y": 830
          width: 140
          height: 14
      stroke: "#ac5a54"
      fill: "#f1d0cd"
      background-color: "#f1d0cd"
      border-color: "#ac5a54"
    Analyzed:
      type: bpmn:EndEvent
      name: Analyzed (n = ...)
      bounds:
        x: 432
        "y": 860
        width: 36
        height: 36
      label:
        bounds:
          x: 410
          "y": 900
          width: 82
          height: 14

    # ---------- Sequence flows ----------
    f_enr_scr:
      type: bpmn:SequenceFlow
      sourceRef: Enrolled
      targetRef: Screening
      waypoint:
        - x: 450
          "y": 128
        - x: 450
          "y": 170
    f_scr_rand:
      type: bpmn:SequenceFlow
      sourceRef: Screening
      targetRef: Randomize
      waypoint:
        - x: 450
          "y": 250
        - x: 450
          "y": 320
    f_screenfail:
      type: bpmn:SequenceFlow
      sourceRef: Screen_fail
      targetRef: Excluded_pre
      name: reason
      waypoint:
        - x: 528
          "y": 250
        - x: 720
          "y": 250
      label:
        bounds:
          x: 604
          "y": 232
          width: 40
          height: 14
      stroke: "#ac5a54"
      border-color: "#ac5a54"
    f_rand_a:
      type: bpmn:SequenceFlow
      sourceRef: Randomize
      targetRef: SelfPaced
      name: self-paced
      waypoint:
        - x: 425
          "y": 345
        - x: 300
          "y": 345
        - x: 300
          "y": 430
      label:
        bounds:
          x: 246
          "y": 325
          width: 62
          height: 14
    f_rand_b:
      type: bpmn:SequenceFlow
      sourceRef: Randomize
      targetRef: TimePressured
      name: speeded
      waypoint:
        - x: 475
          "y": 345
        - x: 600
          "y": 345
        - x: 600
          "y": 430
      label:
        bounds:
          x: 556
          "y": 325
          width: 60
          height: 14
    f_a_drop:
      type: bpmn:SequenceFlow
      sourceRef: SelfPaced_drop
      targetRef: Dropped
      name: reason
      waypoint:
        - x: 360
          "y": 528
        - x: 360
          "y": 578
        - x: 432
          "y": 578
      label:
        bounds:
          x: 366
          "y": 560
          width: 40
          height: 14
      stroke: "#ac5a54"
      border-color: "#ac5a54"
    f_b_drop:
      type: bpmn:SequenceFlow
      sourceRef: TimePressured_drop
      targetRef: Dropped
      name: reason
      waypoint:
        - x: 540
          "y": 528
        - x: 540
          "y": 578
        - x: 468
          "y": 578
      label:
        bounds:
          x: 494
          "y": 560
          width: 40
          height: 14
      stroke: "#ac5a54"
      border-color: "#ac5a54"
    f_a_an:
      type: bpmn:SequenceFlow
      sourceRef: SelfPaced
      targetRef: Analyze_A
      waypoint:
        - x: 300
          "y": 510
        - x: 300
          "y": 670
    f_b_an:
      type: bpmn:SequenceFlow
      sourceRef: TimePressured
      targetRef: Analyze_B
      waypoint:
        - x: 600
          "y": 510
        - x: 600
          "y": 670
    f_a_excl:
      type: bpmn:SequenceFlow
      sourceRef: Analyze_A_excl
      targetRef: Excluded_analysis
      waypoint:
        - x: 360
          "y": 768
        - x: 360
          "y": 808
        - x: 432
          "y": 808
      stroke: "#ac5a54"
      border-color: "#ac5a54"
    f_b_excl:
      type: bpmn:SequenceFlow
      sourceRef: Analyze_B_excl
      targetRef: Excluded_analysis
      waypoint:
        - x: 540
          "y": 768
        - x: 540
          "y": 808
        - x: 468
          "y": 808
      stroke: "#ac5a54"
      border-color: "#ac5a54"
    f_a_done:
      type: bpmn:SequenceFlow
      sourceRef: Analyze_A
      targetRef: Analyzed
      waypoint:
        - x: 300
          "y": 750
        - x: 300
          "y": 878
        - x: 432
          "y": 878
    f_b_done:
      type: bpmn:SequenceFlow
      sourceRef: Analyze_B
      targetRef: Analyzed
      waypoint:
        - x: 600
          "y": 750
        - x: 600
          "y": 878
        - x: 468
          "y": 878

  artifacts:
    Group_Enrolment:
      type: bpmn:Group
      categoryValueRef: CategoryValue_Enrolment
      bounds:
        x: 100
        "y": 70
        width: 720
        height: 230
      label:
        bounds:
          x: 116
          "y": 78
          width: 80
          height: 14
    Group_Allocation:
      type: bpmn:Group
      categoryValueRef: CategoryValue_Allocation
      bounds:
        x: 100
        "y": 300
        width: 720
        height: 110
      label:
        bounds:
          x: 116
          "y": 308
          width: 80
          height: 14
    Group_Followup:
      type: bpmn:Group
      categoryValueRef: CategoryValue_Followup
      bounds:
        x: 100
        "y": 410
        width: 720
        height: 230
      label:
        bounds:
          x: 116
          "y": 418
          width: 80
          height: 14
    Group_Analysis:
      type: bpmn:Group
      categoryValueRef: CategoryValue_Analysis
      bounds:
        x: 100
        "y": 640
        width: 720
        height: 270
      label:
        bounds:
          x: 116
          "y": 648
          width: 80
          height: 14

Category_Enrolment:
  type: bpmn:Category
  categoryValue:
    CategoryValue_Enrolment:
      value: Enrolment
Category_Allocation:
  type: bpmn:Category
  categoryValue:
    CategoryValue_Allocation:
      value: Allocation
Category_Followup:
  type: bpmn:Category
  categoryValue:
    CategoryValue_Followup:
      value: Follow-up
Category_Analysis:
  type: bpmn:Category
  categoryValue:
    CategoryValue_Analysis:
      value: Analysis
