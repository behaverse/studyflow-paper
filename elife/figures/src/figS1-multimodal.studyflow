id: figS1_multimodal
definitions:
  targetNamespace: http://bpmn.io/schema/bpmn
  xmlns:bpmn2: http://www.omg.org/spec/BPMN/20100524/MODEL
  xmlns:functional: https://w3id.org/studyflow/functional
Multimodal_Pipeline:
  type: Process
  documentation: >-
    Figure S1: a use-case pipeline harmonizing EEG, fMRI, and behavioral recordings. Three source datasets feed
    modality-specific preprocessing (fMRIPrep, EEGPrep, BDM conversion); a compose/expansion step produces a harmonized
    corpus, then a training chain.
  extensionElements:
    - type: studyflow:Study
  name: Multimodal preprocessing and training
  flowElements:
    eeg_raw:
      type: DataStoreReference
      extensionElements:
        - type: studyflow:Dataset
          format: bids
          bidsDataType: eeg
          catalog: openneuro
      name: EEG (BIDS)
      bounds: 120 97 50 50
    fmri_raw:
      type: DataStoreReference
      extensionElements:
        - type: studyflow:Dataset
          format: bids
          bidsDataType: func
          catalog: openneuro
      name: fMRI (BIDS)
      bounds: 120 297 50 50
    beh_raw:
      type: DataStoreReference
      extensionElements:
        - type: studyflow:Dataset
          format: bdm
          catalog: behaverse
      name: behavior
      bounds: 120 497 50 50
    EEGPrep:
      type: SubProcess
      extensionElements:
        - type: functional:map
      name: EEGPrep
      properties:
        Prop_da_eeg:
          name: __targetRef_placeholder
      dataInputAssociations:
        da_eeg:
          sourceRef:
            - eeg_raw
          targetRef: Prop_da_eeg
          waypoint: 170,114 280,82
      bounds: 280 40 120 80
    fMRIPrep:
      type: ServiceTask
      extensionElements:
        - type: functional:map
      name: fMRIPrep
      properties:
        Prop_da_fmri:
          name: __targetRef_placeholder
      dataInputAssociations:
        da_fmri:
          sourceRef:
            - fmri_raw
          targetRef: Prop_da_fmri
          waypoint: 170,318 280,295
      bounds: 280 260 120 80
    BehConv:
      type: ServiceTask
      extensionElements:
        - type: functional:map
      name: BDM conversion
      properties:
        Prop_da_beh:
          name: __targetRef_placeholder
      dataInputAssociations:
        da_beh:
          sourceRef:
            - beh_raw
          targetRef: Prop_da_beh
          waypoint: 170,518 280,495
      implementation: python://behaverse.to_bdm@1.0
      bounds: 280 460 120 80
    Compose:
      type: ServiceTask
      extensionElements: {}
      name: Compose (multiverse)
      dataOutputAssociations:
        da_harm:
          targetRef: harmonized
          waypoint: 620,298 690,324
      implementation: python://omniprocess.compose@1.0
      bounds: 500 260 120 80
    harmonized:
      type: DataStoreReference
      extensionElements:
        - type: studyflow:Dataset
          format: bdm
          bdmDataLevel: models
          catalog: behaverse
      name: harmonized corpus
      bounds: 690 307 50 50
    Split:
      type: ExclusiveGateway
      name: Split train/test
      properties: "[object Object]"
      dataInputAssociations: "[object Object]"
      bounds: 860 302 50 50
      isMarkerVisible: true
    Train:
      type: ServiceTask
      extensionElements:
        - type: functional:reduce
      name: Train model
      implementation: python://models.train@1.0
      bounds: 960 200 120 80
    Evaluate:
      type: ServiceTask
      extensionElements:
        - type: functional:map
      name: Evaluate
      implementation: python://models.evaluate@1.0
      bounds: 960 320 120 80
    Done:
      type: EndEvent
      name: Done
      bounds: 1130 312 36 36
    m1:
      sourceRef: EEGPrep
      targetRef: Compose
      waypoint: 380,120 520,260
    m2:
      sourceRef: fMRIPrep
      targetRef: Compose
      waypoint: 400,300 500,300
    m3:
      sourceRef: BehConv
      targetRef: Compose
      waypoint: 383,460 517,340
    m4:
      sourceRef: Compose
      targetRef: Split
      waypoint: 620,305 860,325
    m5:
      name: train
      sourceRef: Split
      targetRef: Train
      waypoint: 910,309 960,277
      label: 920 247 30 14
    m6:
      name: test
      sourceRef: Split
      targetRef: Evaluate
      waypoint: 910,334 960,341
      label: 923 307 24 14
    m7:
      sourceRef: Train
      targetRef: Done
      waypoint: 1079,280 1130,316
    m8:
      sourceRef: Evaluate
      targetRef: Done
      waypoint: 1080,343 1130,335
  isExecutable: false
diagram:
  - id: BPMNDiagram_1
    plane:
      id: BPMNPlane_1
      bpmnElement: Multimodal_Pipeline
  - plane:
      bpmnElement: EEGPrep
