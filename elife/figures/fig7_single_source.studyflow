id: fig7_single_source
definitions:
  targetNamespace: http://bpmn.io/schema/bpmn
  xmlns:xsi: http://www.w3.org/2001/XMLSchema-instance
  xmlns:bpmn2: http://www.omg.org/spec/BPMN/20100524/MODEL
  xmlns:bpmndi: http://www.omg.org/spec/BPMN/20100524/DI
  xmlns:dc: http://www.omg.org/spec/DD/20100524/DC
  xmlns:di: http://www.omg.org/spec/DD/20100524/DI
  xmlns:studyflow: http://behaverse.org/schemas/studyflow/v1
  xmlns:cognitive: http://behaverse.org/schemas/studyflow/cognitive
  xmlns:datatrove: https://w3id.org/studyflow/datatrove
  xmlns:bioc: http://bpmn.io/schema/bpmn/biocolor/1.0
  xmlns:color: http://www.omg.org/spec/BPMN/non-normative/color/1.0
Study_Single_Source:
  type: bpmn:Process
  extensionElements:
    - type: studyflow:Study
  name: study.studyflow
  documentation: >-
    Figure 7: the single source file whose Schedule (Gantt), Checklist (audit), and Participant-flow (CONSORT) views are
    all projections. Activities carry onset/duration for the Gantt; the eligibility and allocation nodes carry declared
    criteria; boundary error events carry the post-run counts.
  flowElements:
    Consent:
      type: bpmn:StartEvent
      name: Consent
      bounds:
        x: 409
        "y": 101
        width: 42
        height: 14
      consentFormUri: https://example.org/protocols/study/consent.pdf
    Screen:
      type: bpmn:Task
      extensionElements:
        - type: cognitive:Questionnaire
          instrument: screening
      name: Screening
      checklist: |-
        - [x] Eligibility criteria - declared
        - [ ] Baseline captured
      onset: T0
      duration: 10min
      bounds:
        x: 370
        "y": 150
        width: 120
        height: 80
    Screen_out:
      type: bpmn:BoundaryEvent
      name: screen-out
      attachedToRef: Screen
      eventDefinitions:
        Screen_out_def:
          type: bpmn:ErrorEventDefinition
      cancelActivity: true
      bounds:
        x: 428
        "y": 253
        width: 60
        height: 14
    Excluded:
      type: bpmn:EndEvent
      name: Excluded (n = 1)
      eventDefinitions:
        Excluded_def:
          type: bpmn:ErrorEventDefinition
      bounds:
        x: 580
        "y": 197
        width: 96
        height: 14
      stroke: "#ac5a54"
      fill: "#f1d0cd"
      background-color: "#f1d0cd"
      border-color: "#ac5a54"
    Allocate:
      type: bpmn:ExclusiveGateway
      extensionElements:
        - type: cognitive:RandomGateway
      name: Allocation
      bounds:
        x: 400
        "y": 345
        width: 60
        height: 14
      isMarkerVisible: true
      checklist: "- [x] Allocation rule - declared"
    Battery:
      type: bpmn:Task
      extensionElements:
        - type: cognitive:CognitiveTask
          instrument: behaverse
      name: Battery
      checklist: "- [x] Model version - pinned"
      onset: T0+10min
      duration: 45min
      bounds:
        x: 370
        "y": 380
        width: 120
        height: 80
    Battery_drop:
      type: bpmn:BoundaryEvent
      name: quit
      attachedToRef: Battery
      eventDefinitions:
        Battery_drop_def:
          type: bpmn:ErrorEventDefinition
      cancelActivity: true
      bounds:
        x: 390
        "y": 483
        width: 24
        height: 14
    DroppedOut:
      type: bpmn:EndEvent
      name: Dropped out (n = 9)
      eventDefinitions:
        DroppedOut_def:
          type: bpmn:ErrorEventDefinition
      bounds:
        x: 571
        "y": 427
        width: 114
        height: 14
      stroke: "#ac5a54"
      fill: "#f1d0cd"
      background-color: "#f1d0cd"
      border-color: "#ac5a54"
    Followup:
      type: bpmn:Task
      extensionElements:
        - type: cognitive:Questionnaire
          instrument: who-5
      name: Follow-up
      onset: T0+55min
      duration: 10min
      bounds:
        x: 370
        "y": 500
        width: 120
        height: 80
    Followup_drop:
      type: bpmn:BoundaryEvent
      name: quit
      attachedToRef: Followup
      eventDefinitions:
        Followup_drop_def:
          type: bpmn:ErrorEventDefinition
      cancelActivity: true
      bounds:
        x: 390
        "y": 603
        width: 24
        height: 14
    DroppedFollow:
      type: bpmn:EndEvent
      name: Dropped out (n = 3)
      eventDefinitions:
        DroppedFollow_def:
          type: bpmn:ErrorEventDefinition
      bounds:
        x: 571
        "y": 547
        width: 114
        height: 14
      stroke: "#ac5a54"
      fill: "#f1d0cd"
      background-color: "#f1d0cd"
      border-color: "#ac5a54"
    Analysis:
      type: bpmn:ServiceTask
      extensionElements:
        - type: datatrove:Reduce
      name: Analysis
      isDataOperation: true
      onset: T0+65min
      duration: 20min
      bounds:
        x: 370
        "y": 620
        width: 120
        height: 80
    Completed:
      type: bpmn:EndEvent
      name: Completed
      bounds:
        x: 403
        "y": 781
        width: 54
        height: 14
    s1:
      type: bpmn:SequenceFlow
      sourceRef: Consent
      targetRef: Screen
      waypoint:
        - x: 430
          "y": 96
        - x: 430
          "y": 150
    s2:
      type: bpmn:SequenceFlow
      sourceRef: Screen
      targetRef: Allocate
      waypoint:
        - x: 430
          "y": 230
        - x: 430
          "y": 290
    s_out:
      type: bpmn:SequenceFlow
      sourceRef: Screen_out
      targetRef: Excluded
      name: reason
      waypoint:
        - x: 476
          "y": 230
        - x: 610
          "y": 174
      label:
        bounds:
          x: 525
          "y": 184
          width: 36
          height: 14
      stroke: "#ac5a54"
      border-color: "#ac5a54"
    s3:
      type: bpmn:SequenceFlow
      sourceRef: Allocate
      targetRef: Battery
      waypoint:
        - x: 430
          "y": 340
        - x: 430
          "y": 380
    s_drop:
      type: bpmn:SequenceFlow
      sourceRef: Battery_drop
      targetRef: DroppedOut
      name: reason
      waypoint:
        - x: 420
          "y": 460
        - x: 610
          "y": 404
      label:
        bounds:
          x: 497
          "y": 414
          width: 36
          height: 14
      stroke: "#ac5a54"
      border-color: "#ac5a54"
    s4:
      type: bpmn:SequenceFlow
      sourceRef: Battery
      targetRef: Followup
      waypoint:
        - x: 430
          "y": 460
        - x: 430
          "y": 500
    s_fdrop:
      type: bpmn:SequenceFlow
      sourceRef: Followup_drop
      targetRef: DroppedFollow
      name: reason
      waypoint:
        - x: 420
          "y": 580
        - x: 610
          "y": 524
      label:
        bounds:
          x: 497
          "y": 534
          width: 36
          height: 14
      stroke: "#ac5a54"
      border-color: "#ac5a54"
    s5:
      type: bpmn:SequenceFlow
      sourceRef: Followup
      targetRef: Analysis
      waypoint:
        - x: 430
          "y": 580
        - x: 430
          "y": 620
    s6:
      type: bpmn:SequenceFlow
      sourceRef: Analysis
      targetRef: Completed
      waypoint:
        - x: 430
          "y": 700
        - x: 430
          "y": 740
  isExecutable: false
