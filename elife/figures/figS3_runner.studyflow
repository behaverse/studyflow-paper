id: figS3_runner
definitions:
  targetNamespace: http://bpmn.io/schema/bpmn
  xmlns:xsi: http://www.w3.org/2001/XMLSchema-instance
  xmlns:bpmn2: http://www.omg.org/spec/BPMN/20100524/MODEL
  xmlns:bpmndi: http://www.omg.org/spec/BPMN/20100524/DI
  xmlns:dc: http://www.omg.org/spec/DD/20100524/DC
  xmlns:di: http://www.omg.org/spec/DD/20100524/DI
  xmlns:studyflow: http://behaverse.org/schemas/studyflow/v1
  xmlns:cognitive: http://behaverse.org/schemas/studyflow/cognitive
Runner_Walkthrough:
  type: bpmn:Process
  extensionElements:
    - type: studyflow:Study
  name: Runner walkthrough
  documentation: >-
    Figure S3 (left column): the five diagram nodes the runner walks - consent start, an instruction, a questionnaire,
    an N-back trial, and the completion end.
  flowElements:
    rw_consent:
      type: bpmn:StartEvent
      name: Consent
      bounds:
        x: 97
        "y": 101
        width: 42
        height: 14
      consentFormUri: https://example.org/consent.pdf
    rw_instr:
      type: bpmn:Task
      extensionElements:
        - type: cognitive:Instruction
          content: Welcome. Press any key to begin.
      name: Instruction
      bounds:
        x: 60
        "y": 160
        width: 120
        height: 80
    rw_quest:
      type: bpmn:Task
      extensionElements:
        - type: cognitive:Questionnaire
          instrument: phq-9
      name: Questionnaire
      bounds:
        x: 60
        "y": 280
        width: 120
        height: 80
    rw_nback:
      type: bpmn:Task
      extensionElements:
        - type: cognitive:CognitiveTask
          instrument: behaverse
      name: N-back trial
      bounds:
        x: 60
        "y": 400
        width: 120
        height: 80
    rw_done:
      type: bpmn:EndEvent
      name: Completion
      bounds:
        x: 88
        "y": 561
        width: 60
        height: 14
    rw1:
      type: bpmn:SequenceFlow
      sourceRef: rw_consent
      targetRef: rw_instr
      waypoint:
        - x: 118
          "y": 96
        - x: 120
          "y": 160
    rw2:
      type: bpmn:SequenceFlow
      sourceRef: rw_instr
      targetRef: rw_quest
      waypoint:
        - x: 120
          "y": 240
        - x: 120
          "y": 280
    rw3:
      type: bpmn:SequenceFlow
      sourceRef: rw_quest
      targetRef: rw_nback
      waypoint:
        - x: 120
          "y": 360
        - x: 120
          "y": 400
    rw4:
      type: bpmn:SequenceFlow
      sourceRef: rw_nback
      targetRef: rw_done
      waypoint:
        - x: 120
          "y": 480
        - x: 118
          "y": 520
  isExecutable: false
