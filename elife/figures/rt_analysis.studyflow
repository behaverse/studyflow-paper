<?xml version="1.0" encoding="UTF-8"?>
<bpmn2:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:studyflow="http://behaverse.org/schemas/studyflow"
  xmlns:cognitive="http://behaverse.org/schemas/studyflow/cognitive"
  id="rt_analysis" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn2:process id="RTAnalysis" name="RT Analysis" isExecutable="true">
    <bpmn2:extensionElements>
      <studyflow:study />
    </bpmn2:extensionElements>
    <bpmn2:documentation>A reproducible response-time analysis. Trials are collected, then summarized by a single composed data operation that reads a BDM trials-level dataset and writes a BDM models-level summary. The composed operation mirrors the tidyverse pipeline filter(correct == 1) |&gt; mutate(log_rt, rt_z) |&gt; group_by(agent_id, condition) |&gt; summarize(rt_mean, rt_sd), with typed inputs and outputs.</bpmn2:documentation>
    <bpmn2:startEvent id="s" name="Start">
      <bpmn2:outgoing>f1</bpmn2:outgoing>
    </bpmn2:startEvent>
    <bpmn2:task id="CollectTrials" name="Collect trials">
      <bpmn2:extensionElements>
        <cognitive:cognitiveTask instrument="psychopy" />
      </bpmn2:extensionElements>
      <bpmn2:incoming>f1</bpmn2:incoming>
      <bpmn2:outgoing>f2</bpmn2:outgoing>
    </bpmn2:task>
    <bpmn2:subProcess id="RTAnalysisPipeline" name="RT analysis pipeline">
      <bpmn2:incoming>f2</bpmn2:incoming>
      <bpmn2:outgoing>f3</bpmn2:outgoing>
      <bpmn2:property id="Property_RTAP_in" name="__targetRef_placeholder" />
      <bpmn2:dataInputAssociation id="DataInput_Raw_RTAP">
        <bpmn2:sourceRef>trials_raw</bpmn2:sourceRef>
        <bpmn2:targetRef>Property_RTAP_in</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataOutputAssociation id="DataOutput_RTAP_Summary">
        <bpmn2:targetRef>trials_summary</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
      <bpmn2:startEvent id="sub_s">
        <bpmn2:outgoing>sf1</bpmn2:outgoing>
      </bpmn2:startEvent>
      <bpmn2:task id="t1" name="Summarize RT" studyflow:isDataOperation="true">
        <bpmn2:documentation>Composed data operation over the trials. Primitives: transform, filter, map, group, reduce. Equivalent dplyr: filter(correct == 1) |&gt; mutate(log_rt = log(rt), rt_z = (rt - mean(rt)) / sd(rt)) |&gt; group_by(agent_id, condition) |&gt; summarize(rt_mean = mean(rt), rt_sd = sd(rt)). Reads trials_raw (BDM trials level); writes trials_summary (BDM models level).</bpmn2:documentation>
        <bpmn2:incoming>sf1</bpmn2:incoming>
        <bpmn2:outgoing>sf2</bpmn2:outgoing>
      </bpmn2:task>
      <bpmn2:endEvent id="sub_e">
        <bpmn2:incoming>sf2</bpmn2:incoming>
      </bpmn2:endEvent>
      <bpmn2:sequenceFlow id="sf1" sourceRef="sub_s" targetRef="t1" />
      <bpmn2:sequenceFlow id="sf2" sourceRef="t1" targetRef="sub_e" />
    </bpmn2:subProcess>
    <bpmn2:endEvent id="e" name="End">
      <bpmn2:incoming>f3</bpmn2:incoming>
    </bpmn2:endEvent>
    <bpmn2:dataStoreReference id="trials_raw" name="trials_raw">
      <bpmn2:extensionElements>
        <studyflow:dataset format="bdm" bdmDataLevel="trials" schema="schema/trials_raw.csvw" catalog="behaverse" storage="ducklake" />
      </bpmn2:extensionElements>
    </bpmn2:dataStoreReference>
    <bpmn2:dataStoreReference id="trials_summary" name="trials_summary">
      <bpmn2:extensionElements>
        <studyflow:dataset format="bdm" bdmDataLevel="models" schema="schema/trials_summary.csvw" catalog="behaverse" storage="ducklake" />
      </bpmn2:extensionElements>
    </bpmn2:dataStoreReference>
    <bpmn2:sequenceFlow id="f1" sourceRef="s" targetRef="CollectTrials" />
    <bpmn2:sequenceFlow id="f2" sourceRef="CollectTrials" targetRef="RTAnalysisPipeline" />
    <bpmn2:sequenceFlow id="f3" sourceRef="RTAnalysisPipeline" targetRef="e" />
  </bpmn2:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="RTAnalysis">
      <bpmndi:BPMNShape id="s_di" bpmnElement="s">
        <dc:Bounds x="180" y="322" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="186" y="365" width="24" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CollectTrials_di" bpmnElement="CollectTrials">
        <dc:Bounds x="260" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="RTAnalysisPipeline_di" bpmnElement="RTAnalysisPipeline" isExpanded="true">
        <dc:Bounds x="420" y="240" width="460" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sub_s_di" bpmnElement="sub_s">
        <dc:Bounds x="450" y="322" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t1_di" bpmnElement="t1">
        <dc:Bounds x="560" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sub_e_di" bpmnElement="sub_e">
        <dc:Bounds x="800" y="322" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e_di" bpmnElement="e">
        <dc:Bounds x="940" y="322" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="948" y="365" width="20" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="trials_raw_di" bpmnElement="trials_raw">
        <dc:Bounds x="585" y="140" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="575" y="193" width="71" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="trials_summary_di" bpmnElement="trials_summary">
        <dc:Bounds x="585" y="490" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="565" y="543" width="91" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1">
        <di:waypoint x="216" y="340" />
        <di:waypoint x="260" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2">
        <di:waypoint x="360" y="340" />
        <di:waypoint x="420" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3">
        <di:waypoint x="880" y="340" />
        <di:waypoint x="940" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf1_di" bpmnElement="sf1">
        <di:waypoint x="486" y="340" />
        <di:waypoint x="560" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf2_di" bpmnElement="sf2">
        <di:waypoint x="660" y="340" />
        <di:waypoint x="800" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DataInput_Raw_RTAP_di" bpmnElement="DataInput_Raw_RTAP">
        <di:waypoint x="610" y="190" />
        <di:waypoint x="610" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DataOutput_RTAP_Summary_di" bpmnElement="DataOutput_RTAP_Summary">
        <di:waypoint x="610" y="440" />
        <di:waypoint x="610" y="490" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn2:definitions>
