id: studyflow_administer_trial
definitions:
  targetNamespace: http://bpmn.io/schema/bpmn
  xmlns:xsi: http://www.w3.org/2001/XMLSchema-instance
  xmlns:bpmn2: http://www.omg.org/spec/BPMN/20100524/MODEL
  xmlns:bpmndi: http://www.omg.org/spec/BPMN/20100524/DI
  xmlns:dc: http://www.omg.org/spec/DD/20100524/DC
  xmlns:di: http://www.omg.org/spec/DD/20100524/DI
  xmlns:studyflow: http://behaverse.org/schemas/studyflow/v1
  xmlns:cognitive: http://behaverse.org/schemas/studyflow/cognitive
  xsi:schemaLocation: http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd
Trial_Protocol:
  type: bpmn:Process
  extensionElements:
    - type: studyflow:Study
  name: One trial
  flowElements:
    T_Start:
      type: bpmn:StartEvent
      name: Next trial
      outgoing:
        - TF_Start_Admin
      bounds:
        x: 200
        "y": 100
        width: 36
        height: 36
      label:
        bounds:
          x: 192
          "y": 143
          width: 52
          height: 14
    T_Administer:
      type: bpmn:Task
      name: Administer trial (see choreography)
      incoming:
        - TF_Start_Admin
      outgoing:
        - TF_Admin_End
      bounds:
        x: 290
        "y": 78
        width: 120
        height: 80
    T_End:
      type: bpmn:EndEvent
      name: Trial logged
      incoming:
        - TF_Admin_End
      bounds:
        x: 470
        "y": 100
        width: 36
        height: 36
      label:
        bounds:
          x: 460
          "y": 143
          width: 58
          height: 14
    TF_Start_Admin:
      type: bpmn:SequenceFlow
      sourceRef: T_Start
      targetRef: T_Administer
      waypoint:
        - x: 236
          "y": 118
        - x: 290
          "y": 118
    TF_Admin_End:
      type: bpmn:SequenceFlow
      sourceRef: T_Administer
      targetRef: T_End
      waypoint:
        - x: 410
          "y": 118
        - x: 470
          "y": 118
  isExecutable: false
Administer_Trial:
  type: bpmn:Choreography
  name: Administer trial
  participants:
    Runner:
      name: Runner
    Trial_Actor:
      extensionElements:
        - type: cognitive:Actor
      name: Actor (human or agent)
  messageFlows:
    MF_Stimulus:
      name: stimulus, options, timing (+ frame)
      sourceRef: Runner
      targetRef: Trial_Actor
    MF_Response:
      name: response (+ latency)
      sourceRef: Trial_Actor
      targetRef: Runner
  flowElements:
    C_Start:
      type: bpmn:StartEvent
      name: Next trial
      outgoing:
        - CF_Start_Present
    CT_Present:
      type: bpmn:ChoreographyTask
      name: Present stimulus
      incoming:
        - CF_Start_Present
      outgoing:
        - CF_Present_Respond
      participantRef:
        - Runner
        - Trial_Actor
      initiatingParticipantRef: Runner
      messageFlowRef:
        - MF_Stimulus
    CT_Respond:
      type: bpmn:ChoreographyTask
      name: Return response
      incoming:
        - CF_Present_Respond
      outgoing:
        - CF_Respond_End
      participantRef:
        - Trial_Actor
        - Runner
      initiatingParticipantRef: Trial_Actor
      messageFlowRef:
        - MF_Response
    C_End:
      type: bpmn:EndEvent
      name: Trial logged
      incoming:
        - CF_Respond_End
    CF_Start_Present:
      type: bpmn:SequenceFlow
      sourceRef: C_Start
      targetRef: CT_Present
    CF_Present_Respond:
      type: bpmn:SequenceFlow
      sourceRef: CT_Present
      targetRef: CT_Respond
    CF_Respond_End:
      type: bpmn:SequenceFlow
      sourceRef: CT_Respond
      targetRef: C_End
diagram:
  - id: BPMNDiagram_Process
    plane:
      id: BPMNPlane_Process
      bpmnElement: Trial_Protocol
  - id: BPMNDiagram_Choreography
    plane:
      id: BPMNPlane_Choreography
      bpmnElement: Administer_Trial
      planeElement:
        C_Start_di:
          type: bpmndi:BPMNShape
          bpmnElement: C_Start
          bounds:
            x: 160
            "y": 160
            width: 36
            height: 36
          label:
            bounds:
              x: 152
              "y": 203
              width: 52
              height: 14
        CT_Present_di:
          type: bpmndi:BPMNShape
          bpmnElement: CT_Present
          bounds:
            x: 260
            "y": 103
            width: 130
            height: 150
        CT_Present_Runner_di:
          type: bpmndi:BPMNShape
          bpmnElement: Runner
          choreographyActivityShape: CT_Present_di
          participantBandKind: top_initiating
          isHorizontal: true
          bounds:
            x: 260
            "y": 103
            width: 130
            height: 20
        CT_Present_Actor_di:
          type: bpmndi:BPMNShape
          bpmnElement: Trial_Actor
          choreographyActivityShape: CT_Present_di
          participantBandKind: bottom_non_initiating
          isHorizontal: true
          bounds:
            x: 260
            "y": 233
            width: 130
            height: 20
        CT_Respond_di:
          type: bpmndi:BPMNShape
          bpmnElement: CT_Respond
          bounds:
            x: 460
            "y": 103
            width: 130
            height: 150
        CT_Respond_Actor_di:
          type: bpmndi:BPMNShape
          bpmnElement: Trial_Actor
          choreographyActivityShape: CT_Respond_di
          participantBandKind: top_initiating
          isHorizontal: true
          bounds:
            x: 460
            "y": 103
            width: 130
            height: 20
        CT_Respond_Runner_di:
          type: bpmndi:BPMNShape
          bpmnElement: Runner
          choreographyActivityShape: CT_Respond_di
          participantBandKind: bottom_non_initiating
          isHorizontal: true
          bounds:
            x: 460
            "y": 233
            width: 130
            height: 20
        C_End_di:
          type: bpmndi:BPMNShape
          bpmnElement: C_End
          bounds:
            x: 660
            "y": 160
            width: 36
            height: 36
          label:
            bounds:
              x: 652
              "y": 203
              width: 58
              height: 14
        CF_Start_Present_di:
          type: bpmndi:BPMNEdge
          bpmnElement: CF_Start_Present
          waypoint:
            - x: 196
              "y": 178
            - x: 260
              "y": 178
        CF_Present_Respond_di:
          type: bpmndi:BPMNEdge
          bpmnElement: CF_Present_Respond
          waypoint:
            - x: 390
              "y": 178
            - x: 460
              "y": 178
        CF_Respond_End_di:
          type: bpmndi:BPMNEdge
          bpmnElement: CF_Respond_End
          waypoint:
            - x: 590
              "y": 178
            - x: 660
              "y": 178
