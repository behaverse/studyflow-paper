<?xml version="1.0" encoding="UTF-8"?>
<bpmn2:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:studyflow="http://behaverse.org/schemas/studyflow" xmlns:cognitive="http://behaverse.org/schemas/studyflow/cognitive" xmlns:behaverse="http://behaverse.org/schemas/studyflow/behaverse" id="cognitive_study" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn2:process id="CognitiveStudy" name="Full Cognitive Study" isExecutable="true">
    <bpmn2:extensionElements>
      <studyflow:study />
    </bpmn2:extensionElements>
    <bpmn2:documentation>A full-featured cognitive study: CONSORT enrollment and eligibility, randomized allocation into two groups, a six-task Behaverse battery driven trial-by-trial by a local Ollama model (text tasks: n-back and digit span; vision tasks via screenshots: multiple-object tracking, pattern comparison, matrix reasoning, card sorting), and an analysis sub-process that reads, filters, maps, reduces, visualizes, and writes the results. The participant flow is executable; the battery and analysis sub-processes run once the runner supports sub-process traversal.</bpmn2:documentation>
    <bpmn2:startEvent id="Start" name="Enrollment" studyflow:consentFormUri="https://example.org/protocols/cognitive-study/consent.pdf">
      <bpmn2:outgoing>Flow_Start_Screening</bpmn2:outgoing>
    </bpmn2:startEvent>
    <bpmn2:task id="Screening" name="Screening" studyflow:checklist="- [ ] Demographic intake&#10;- [ ] Medical history&#10;- [ ] Inclusion/exclusion criteria&#10;- [ ] Baseline cognitive screen">
      <bpmn2:extensionElements>
        <cognitive:questionnaire instrument="screening" />
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_Start_Screening</bpmn2:incoming>
      <bpmn2:outgoing>Flow_Screening_Eligibility</bpmn2:outgoing>
    </bpmn2:task>
    <bpmn2:exclusiveGateway id="Eligibility_Gateway" name="Assessed for eligibility">
      <bpmn2:extensionElements>
        <cognitive:eligibilityGateway />
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_Screening_Eligibility</bpmn2:incoming>
      <bpmn2:outgoing>Flow_Eligible</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_NotEligible</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:endEvent id="Excluded_Pre" name="Excluded (n=...)">
      <bpmn2:incoming>Flow_NotEligible</bpmn2:incoming>
      <bpmn2:errorEventDefinition id="ErrorDef_ExcludedPre" />
    </bpmn2:endEvent>
    <bpmn2:task id="PHQ9" name="PHQ-9">
      <bpmn2:extensionElements>
        <cognitive:questionnaire instrument="phq-9" />
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_Eligible</bpmn2:incoming>
      <bpmn2:outgoing>Flow_PHQ9_GAD7</bpmn2:outgoing>
    </bpmn2:task>
    <bpmn2:task id="GAD7" name="GAD-7">
      <bpmn2:extensionElements>
        <cognitive:questionnaire instrument="gad-7" />
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_PHQ9_GAD7</bpmn2:incoming>
      <bpmn2:outgoing>Flow_GAD7_Randomize</bpmn2:outgoing>
    </bpmn2:task>
    <bpmn2:exclusiveGateway id="Randomize_Gateway" name="Randomization">
      <bpmn2:extensionElements>
        <cognitive:randomGateway />
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_GAD7_Randomize</bpmn2:incoming>
      <bpmn2:outgoing>Flow_Group_A</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_Group_B</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:task id="Allocate_A" name="Group A (self-paced)" studyflow:checklist="- [ ] Allocation concealed until enrollment&#10;- [ ] Condition recorded in trials table">
      <bpmn2:extensionElements>
        <cognitive:instruction content="# Group A&#10;&#10;You will complete the tasks at your own pace. Take as long as you need on each trial." />
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_Group_A</bpmn2:incoming>
      <bpmn2:outgoing>Flow_A_Merge</bpmn2:outgoing>
    </bpmn2:task>
    <bpmn2:task id="Allocate_B" name="Group B (time-pressured)" studyflow:checklist="- [ ] Allocation concealed until enrollment&#10;- [ ] Condition recorded in trials table">
      <bpmn2:extensionElements>
        <cognitive:instruction content="# Group B&#10;&#10;You will complete the tasks under time pressure. Respond as quickly as you can while staying accurate." />
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_Group_B</bpmn2:incoming>
      <bpmn2:outgoing>Flow_B_Merge</bpmn2:outgoing>
    </bpmn2:task>
    <bpmn2:exclusiveGateway id="Merge_Gateway" name="Begin battery">
      <bpmn2:incoming>Flow_A_Merge</bpmn2:incoming>
      <bpmn2:incoming>Flow_B_Merge</bpmn2:incoming>
      <bpmn2:outgoing>Flow_Merge_Battery</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:subProcess id="Battery" name="Cognitive battery (6 tasks)">
      <bpmn2:incoming>Flow_Merge_Battery</bpmn2:incoming>
      <bpmn2:outgoing>Flow_Battery_Analysis</bpmn2:outgoing>
      <bpmn2:dataOutputAssociation id="DataOutput_RawTrials">
        <bpmn2:targetRef>RawTrials</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
      <bpmn2:startEvent id="B_Start" name="Start">
        <bpmn2:outgoing>Flow_B_Start_NB</bpmn2:outgoing>
      </bpmn2:startEvent>
      <bpmn2:task id="Task_NB" name="N-back&#10;(text)">
        <bpmn2:extensionElements>
          <behaverse:task scene="NB" configMode="inline" agentType="bot">
            <behaverse:botConfigurations>ResponseSource: llm
LLM:
  Provider: ollama
  Model: gemma4:e2b-mlx
Prompt: |
  You are an attentive, expert participant aiming for high accuracy.
  In this 2-back task, reply Match if the current letter is identical to the
  letter shown two trials ago, otherwise NonMatch. Reply with exactly Match
  or NonMatch; no explanation.
Speed: 20
SkipInstructions: true
AutoClickInstructions: true
SkipFocusArea: true
OverrideTemporalParameters: true
StimulusDisplayDuration: 0.5
InterStimulusInterval: 1.5
useNonMatchButton: true
maxResponseTime: 15</behaverse:botConfigurations>
            <cognitive:configurations>Blocks:
  Study_NBack:
    Name: Study_NBack
    Inherits: Default
    Parameters:
      NValue: 2
      Feature: Letters
      Streams:
        - Feature:
            Reference: Feature
          StimulusValue:
            Generate: OncePerBlock
            Sequence:
              Type: Ordered
              Values: [3, 1, 2, 1, 3, 2, 3, 2, 1, 2, 3, 1]
      StreamSize: 12
      FeatureValuesCount: 3
      StimulusDisplayDuration: 0.5
      InterStimulusInterval: 1.5
Timelines:
  Study_NBack:
    Name: Study_NBack
    blocks:
      - name: Study_NBack
</cognitive:configurations>
          </behaverse:task>
        </bpmn2:extensionElements>
        <bpmn2:incoming>Flow_B_Start_NB</bpmn2:incoming>
        <bpmn2:outgoing>Flow_NB_DS</bpmn2:outgoing>
      </bpmn2:task>
      <bpmn2:task id="Task_DS" name="Digit span&#10;(text)">
        <bpmn2:extensionElements>
          <behaverse:task scene="DS" agentType="bot">
            <behaverse:botConfigurations>ResponseSource: llm
LLM:
  Provider: ollama
  Model: gemma4:e2b-mlx
Prompt: |
  You are an attentive, expert participant aiming for high accuracy.
  In this digit-span task, after the digits are shown, reproduce them in the
  order presented. Reply with the digits separated by spaces; nothing else.
Speed: 20
SkipInstructions: true
AutoClickInstructions: true
SkipFocusArea: true
maxResponseTime: 30</behaverse:botConfigurations>
          </behaverse:task>
        </bpmn2:extensionElements>
        <bpmn2:incoming>Flow_NB_DS</bpmn2:incoming>
        <bpmn2:outgoing>Flow_DS_MOT</bpmn2:outgoing>
      </bpmn2:task>
      <bpmn2:task id="Task_MOT" name="Object tracking&#10;(vision)">
        <bpmn2:extensionElements>
          <behaverse:task scene="MOT" agentType="bot">
            <behaverse:botConfigurations>ResponseSource: llm
IncludeScreenshot: true
LLM:
  Provider: ollama
  Model: llava:13b
Prompt: |
  You are an attentive, expert participant aiming for high accuracy.
  You will see a screenshot of a multiple-object tracking display. Identify
  and select the objects that were cued as targets at the start of the trial.
  Reply with the positions of the targets you select; nothing else.
Speed: 5
SkipInstructions: true
AutoClickInstructions: true
SkipFocusArea: true</behaverse:botConfigurations>
          </behaverse:task>
        </bpmn2:extensionElements>
        <bpmn2:incoming>Flow_DS_MOT</bpmn2:incoming>
        <bpmn2:outgoing>Flow_MOT_PC</bpmn2:outgoing>
      </bpmn2:task>
      <bpmn2:task id="Task_PC" name="Pattern comparison&#10;(vision)">
        <bpmn2:extensionElements>
          <behaverse:task scene="PC" agentType="bot">
            <behaverse:botConfigurations>ResponseSource: llm
IncludeScreenshot: true
LLM:
  Provider: ollama
  Model: llava:13b
Prompt: |
  You are an attentive, expert participant aiming for high accuracy.
  You will see a screenshot of a pattern-comparison trial showing two
  patterns side by side. Reply Same if they are identical, Different
  otherwise. Reply with exactly Same or Different.
Speed: 5
SkipInstructions: true
AutoClickInstructions: true
SkipFocusArea: true</behaverse:botConfigurations>
          </behaverse:task>
        </bpmn2:extensionElements>
        <bpmn2:incoming>Flow_MOT_PC</bpmn2:incoming>
        <bpmn2:outgoing>Flow_PC_BM</bpmn2:outgoing>
      </bpmn2:task>
      <bpmn2:task id="Task_BM" name="Matrix reasoning&#10;(vision)">
        <bpmn2:extensionElements>
          <behaverse:task scene="BM" agentType="bot">
            <behaverse:botConfigurations>ResponseSource: llm
IncludeScreenshot: true
LLM:
  Provider: ollama
  Model: llava:13b
Prompt: |
  You are an attentive, expert participant aiming for high accuracy.
  You will see a screenshot of a matrix-reasoning problem with a missing
  cell and several answer options. Choose the option that completes the
  pattern. Reply with exactly the option label; nothing else.
Speed: 5
SkipInstructions: true
AutoClickInstructions: true
SkipFocusArea: true</behaverse:botConfigurations>
          </behaverse:task>
        </bpmn2:extensionElements>
        <bpmn2:incoming>Flow_PC_BM</bpmn2:incoming>
        <bpmn2:outgoing>Flow_BM_BCS</bpmn2:outgoing>
      </bpmn2:task>
      <bpmn2:task id="Task_BCS" name="Card sorting&#10;(vision)">
        <bpmn2:extensionElements>
          <behaverse:task scene="BCS" agentType="bot">
            <behaverse:botConfigurations>ResponseSource: llm
IncludeScreenshot: true
LLM:
  Provider: ollama
  Model: llava:13b
Prompt: |
  You are an attentive, expert participant aiming for high accuracy.
  You will see a screenshot of a card-sorting screen. Sort the card at the
  bottom onto the matching pile under the current rule, inferring the rule
  from recent feedback. Reply with the target pile; nothing else.
Speed: 5
SkipInstructions: true
AutoClickInstructions: true
SkipFocusArea: true</behaverse:botConfigurations>
          </behaverse:task>
        </bpmn2:extensionElements>
        <bpmn2:incoming>Flow_BM_BCS</bpmn2:incoming>
        <bpmn2:outgoing>Flow_BCS_End</bpmn2:outgoing>
      </bpmn2:task>
      <bpmn2:endEvent id="B_End" name="Done">
        <bpmn2:incoming>Flow_BCS_End</bpmn2:incoming>
      </bpmn2:endEvent>
      <bpmn2:sequenceFlow id="Flow_B_Start_NB" sourceRef="B_Start" targetRef="Task_NB" />
      <bpmn2:sequenceFlow id="Flow_NB_DS" sourceRef="Task_NB" targetRef="Task_DS" />
      <bpmn2:sequenceFlow id="Flow_DS_MOT" sourceRef="Task_DS" targetRef="Task_MOT" />
      <bpmn2:sequenceFlow id="Flow_MOT_PC" sourceRef="Task_MOT" targetRef="Task_PC" />
      <bpmn2:sequenceFlow id="Flow_PC_BM" sourceRef="Task_PC" targetRef="Task_BM" />
      <bpmn2:sequenceFlow id="Flow_BM_BCS" sourceRef="Task_BM" targetRef="Task_BCS" />
      <bpmn2:sequenceFlow id="Flow_BCS_End" sourceRef="Task_BCS" targetRef="B_End" />
    </bpmn2:subProcess>
    <bpmn2:boundaryEvent id="Dropout" name="Dropped out (n=...)" attachedToRef="Battery">
      <bpmn2:outgoing>Flow_Dropout_Excluded</bpmn2:outgoing>
      <bpmn2:errorEventDefinition id="ErrorDef_Dropout" />
    </bpmn2:boundaryEvent>
    <bpmn2:subProcess id="Analysis" name="Analysis and visualization" studyflow:checklist="- [ ] Pre-registered analysis plan applied&#10;- [ ] Outliers reviewed&#10;- [ ] Figures reproducible from seed">
      <bpmn2:incoming>Flow_Battery_Analysis</bpmn2:incoming>
      <bpmn2:outgoing>Flow_Analysis_Complete</bpmn2:outgoing>
      <bpmn2:property id="Property_Analysis_in" name="__targetRef_placeholder" />
      <bpmn2:dataInputAssociation id="DataInput_RawTrials_Analysis">
        <bpmn2:sourceRef>RawTrials</bpmn2:sourceRef>
        <bpmn2:targetRef>Property_Analysis_in</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataOutputAssociation id="DataOutput_Summary">
        <bpmn2:targetRef>Summary</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
      <bpmn2:dataOutputAssociation id="DataOutput_Figures">
        <bpmn2:targetRef>Figures</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
      <bpmn2:startEvent id="A_Start" name="Start">
        <bpmn2:outgoing>Flow_A_Start_Read</bpmn2:outgoing>
      </bpmn2:startEvent>
      <bpmn2:serviceTask id="A_Read" name="Read raw trials" studyflow:isDataOperation="true" studyflow:operationType="transform">
        <bpmn2:incoming>Flow_A_Start_Read</bpmn2:incoming>
        <bpmn2:outgoing>Flow_A_Read_Filter</bpmn2:outgoing>
      </bpmn2:serviceTask>
      <bpmn2:serviceTask id="A_Filter" name="Filter invalid trials" studyflow:isDataOperation="true" studyflow:operationType="filter">
        <bpmn2:incoming>Flow_A_Read_Filter</bpmn2:incoming>
        <bpmn2:outgoing>Flow_A_Filter_Map</bpmn2:outgoing>
      </bpmn2:serviceTask>
      <bpmn2:serviceTask id="A_Map" name="Derive log-RT and accuracy" studyflow:isDataOperation="true" studyflow:operationType="map">
        <bpmn2:incoming>Flow_A_Filter_Map</bpmn2:incoming>
        <bpmn2:outgoing>Flow_A_Map_Branch</bpmn2:outgoing>
      </bpmn2:serviceTask>
      <bpmn2:exclusiveGateway id="A_Branch" name="Design (within / between)">
        <bpmn2:incoming>Flow_A_Map_Branch</bpmn2:incoming>
        <bpmn2:outgoing>Flow_A_Branch_Within</bpmn2:outgoing>
        <bpmn2:outgoing>Flow_A_Branch_Between</bpmn2:outgoing>
      </bpmn2:exclusiveGateway>
      <bpmn2:serviceTask id="A_Group" name="Group by task, group, persona" studyflow:isDataOperation="true" studyflow:operationType="map">
        <bpmn2:incoming>Flow_A_Branch_Within</bpmn2:incoming>
        <bpmn2:incoming>Flow_A_Branch_Between</bpmn2:incoming>
        <bpmn2:outgoing>Flow_A_Group_Reduce</bpmn2:outgoing>
      </bpmn2:serviceTask>
      <bpmn2:serviceTask id="A_Reduce" name="Reduce to accuracy, median RT, SE" studyflow:isDataOperation="true" studyflow:operationType="reduce">
        <bpmn2:incoming>Flow_A_Group_Reduce</bpmn2:incoming>
        <bpmn2:outgoing>Flow_A_Reduce_Review</bpmn2:outgoing>
      </bpmn2:serviceTask>
      <bpmn2:userTask id="A_Review" name="Manual outlier review">
        <bpmn2:incoming>Flow_A_Reduce_Review</bpmn2:incoming>
        <bpmn2:outgoing>Flow_A_Review_Viz</bpmn2:outgoing>
      </bpmn2:userTask>
      <bpmn2:scriptTask id="A_Visualize" name="Plot accuracy and RT" scriptFormat="python">
        <bpmn2:incoming>Flow_A_Review_Viz</bpmn2:incoming>
        <bpmn2:outgoing>Flow_A_Viz_Write</bpmn2:outgoing>
        <bpmn2:script>import seaborn as sns, matplotlib.pyplot as plt
g = sns.catplot(data=summary, x="task", y="accuracy", hue="group",
                col="persona", kind="bar")
g.savefig("figures/accuracy_by_task.png")
sns.relplot(data=trials, x="task", y="rt_ms", hue="model", kind="line")
plt.savefig("figures/rt_by_task.png")</bpmn2:script>
      </bpmn2:scriptTask>
      <bpmn2:serviceTask id="A_Write" name="Write summary table" studyflow:isDataOperation="true" studyflow:operationType="transform">
        <bpmn2:incoming>Flow_A_Viz_Write</bpmn2:incoming>
        <bpmn2:outgoing>Flow_A_Write_End</bpmn2:outgoing>
      </bpmn2:serviceTask>
      <bpmn2:endEvent id="A_End" name="Done">
        <bpmn2:incoming>Flow_A_Write_End</bpmn2:incoming>
      </bpmn2:endEvent>
      <bpmn2:sequenceFlow id="Flow_A_Start_Read" sourceRef="A_Start" targetRef="A_Read" />
      <bpmn2:sequenceFlow id="Flow_A_Read_Filter" sourceRef="A_Read" targetRef="A_Filter" />
      <bpmn2:sequenceFlow id="Flow_A_Filter_Map" sourceRef="A_Filter" targetRef="A_Map" />
      <bpmn2:sequenceFlow id="Flow_A_Map_Branch" sourceRef="A_Map" targetRef="A_Branch" />
      <bpmn2:sequenceFlow id="Flow_A_Branch_Within" name="within-subject" sourceRef="A_Branch" targetRef="A_Group" />
      <bpmn2:sequenceFlow id="Flow_A_Branch_Between" name="between-subject" sourceRef="A_Branch" targetRef="A_Group" />
      <bpmn2:sequenceFlow id="Flow_A_Group_Reduce" sourceRef="A_Group" targetRef="A_Reduce" />
      <bpmn2:sequenceFlow id="Flow_A_Reduce_Review" sourceRef="A_Reduce" targetRef="A_Review" />
      <bpmn2:sequenceFlow id="Flow_A_Review_Viz" sourceRef="A_Review" targetRef="A_Visualize" />
      <bpmn2:sequenceFlow id="Flow_A_Viz_Write" sourceRef="A_Visualize" targetRef="A_Write" />
      <bpmn2:sequenceFlow id="Flow_A_Write_End" sourceRef="A_Write" targetRef="A_End" />
    </bpmn2:subProcess>
    <bpmn2:endEvent id="Complete" name="Completed" studyflow:redirectTo="https://app.prolific.com/submissions/complete?cc={COMPLETION_CODE}" studyflow:completionCodeType="dynamic">
      <bpmn2:incoming>Flow_Analysis_Complete</bpmn2:incoming>
    </bpmn2:endEvent>
    <bpmn2:endEvent id="Excluded_Post" name="Excluded (n=...)">
      <bpmn2:incoming>Flow_Dropout_Excluded</bpmn2:incoming>
      <bpmn2:errorEventDefinition id="ErrorDef_ExcludedPost" />
    </bpmn2:endEvent>
    <bpmn2:dataStoreReference id="RawTrials" name="Raw trials (BDM)">
      <bpmn2:extensionElements>
        <studyflow:dataset format="bdm" bdmDataLevel="trials" />
      </bpmn2:extensionElements>
    </bpmn2:dataStoreReference>
    <bpmn2:dataStoreReference id="Summary" name="Summary (BDM models)">
      <bpmn2:extensionElements>
        <studyflow:dataset format="bdm" bdmDataLevel="models" />
      </bpmn2:extensionElements>
    </bpmn2:dataStoreReference>
    <bpmn2:dataStoreReference id="Figures" name="Figures">
      <bpmn2:extensionElements>
        <studyflow:dataset format="undefined" />
      </bpmn2:extensionElements>
    </bpmn2:dataStoreReference>
    <bpmn2:sequenceFlow id="Flow_Start_Screening" sourceRef="Start" targetRef="Screening" />
    <bpmn2:sequenceFlow id="Flow_Screening_Eligibility" sourceRef="Screening" targetRef="Eligibility_Gateway" />
    <bpmn2:sequenceFlow id="Flow_Eligible" name="eligible" sourceRef="Eligibility_Gateway" targetRef="PHQ9" />
    <bpmn2:sequenceFlow id="Flow_NotEligible" name="not eligible" sourceRef="Eligibility_Gateway" targetRef="Excluded_Pre" />
    <bpmn2:sequenceFlow id="Flow_PHQ9_GAD7" sourceRef="PHQ9" targetRef="GAD7" />
    <bpmn2:sequenceFlow id="Flow_GAD7_Randomize" sourceRef="GAD7" targetRef="Randomize_Gateway" />
    <bpmn2:sequenceFlow id="Flow_Group_A" name="Group A" sourceRef="Randomize_Gateway" targetRef="Allocate_A" />
    <bpmn2:sequenceFlow id="Flow_Group_B" name="Group B" sourceRef="Randomize_Gateway" targetRef="Allocate_B" />
    <bpmn2:sequenceFlow id="Flow_A_Merge" sourceRef="Allocate_A" targetRef="Merge_Gateway" />
    <bpmn2:sequenceFlow id="Flow_B_Merge" sourceRef="Allocate_B" targetRef="Merge_Gateway" />
    <bpmn2:sequenceFlow id="Flow_Merge_Battery" sourceRef="Merge_Gateway" targetRef="Battery" />
    <bpmn2:sequenceFlow id="Flow_Battery_Analysis" sourceRef="Battery" targetRef="Analysis" />
    <bpmn2:sequenceFlow id="Flow_Analysis_Complete" sourceRef="Analysis" targetRef="Complete" />
    <bpmn2:sequenceFlow id="Flow_Dropout_Excluded" name="reason" sourceRef="Dropout" targetRef="Excluded_Post" />
  </bpmn2:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="CognitiveStudy">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <dc:Bounds x="152" y="222" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="144" y="265" width="55" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Screening_di" bpmnElement="Screening">
        <dc:Bounds x="240" y="200" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Eligibility_Gateway_di" bpmnElement="Eligibility_Gateway" isMarkerVisible="true">
        <dc:Bounds x="400" y="215" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="385" y="185" width="82" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Excluded_Pre_di" bpmnElement="Excluded_Pre" bioc:stroke="#ac5a54" bioc:fill="#f1d0cd" color:background-color="#f1d0cd" color:border-color="#ac5a54">
        <dc:Bounds x="407" y="350" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="397" y="393" width="56" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PHQ9_di" bpmnElement="PHQ9">
        <dc:Bounds x="510" y="200" width="100" height="80" />
