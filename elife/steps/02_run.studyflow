id: step02_run
definitions:
  targetNamespace: http://bpmn.io/schema/bpmn
  xmlns:xsi: http://www.w3.org/2001/XMLSchema-instance
  xmlns:bpmn2: http://www.omg.org/spec/BPMN/20100524/MODEL
  xmlns:bpmndi: http://www.omg.org/spec/BPMN/20100524/DI
  xmlns:dc: http://www.omg.org/spec/DD/20100524/DC
  xmlns:di: http://www.omg.org/spec/DD/20100524/DI
  xmlns:bioc: http://bpmn.io/schema/bpmn/biocolor/1.0
  xmlns:color: http://www.omg.org/spec/BPMN/non-normative/color/1.0
  xmlns:studyflow: http://behaverse.org/schemas/studyflow/v1
  xmlns:cognitive: http://behaverse.org/schemas/studyflow/cognitive
  xmlns:behaverse: http://behaverse.org/schemas/studyflow/behaverse

Run_Collaboration:
  type: bpmn:Collaboration
  participants:
    Participant_Run:
      name: "Step 2 — Run"
      processRef: Run
      bounds:
        x: 160
        "y": 40
        width: 1000
        height: 960
      isHorizontal: true

Run:
  type: bpmn:Process
  documentation: >-
    Step 2 of the example study: the run as a complete, runnable fragment, the
    follow-up phase of the CONSORT flow. Six Behaverse tasks plus the jsPsych
    Flanker, administered one trial at a time through one message-passing
    interface (human or artificial actor alike); every trial is logged to the
    BDM trials dataset under the declared schema. A run whose failed-trial rate
    exceeds 20% on any task exits through a boundary error event to a single
    counted error end event.
  extensionElements:
    - type: studyflow:Study
      runtime: browser
      # Study seed: with a subject identifier i, fixes task order, stimulus
      # order, and every random branch draw.
      seed: 42
  name: Step 2 - Run
  isExecutable: true

  laneSets:
    LaneSet_Run:
      lanes:
        Lane_Followup:
          name: Follow-up (cognitive battery)
          flowNodeRef:
            - Battery_Start
            - Task_NBack
            - Failed_NBack
            - Task_DigitSpan
            - Failed_DigitSpan
            - Task_Flanker
            - Failed_Flanker
            - Task_SART
            - Failed_SART
            - Task_SRT
            - Failed_SRT
            - Task_Matrices
            - Failed_Matrices
            - Task_CardSorting
            - Failed_CardSorting
            - ErrEnd_FailedTrials
            - Battery_End
          bounds:
            x: 190
            "y": 40
            width: 970
            height: 960
          isHorizontal: true

  flowElements:

    Battery_Start:
      type: bpmn:StartEvent
      name: Begin battery
      bounds:
        x: 412
        "y": 72
        width: 36
        height: 36
      label:
        bounds:
          x: 456
          "y": 83
          width: 90
          height: 14

    Task_NBack:
      type: bpmn:Task
      extensionElements:
        - type: behaverse:Task
          scene: NB
          configurations:
            NValue: 2
            TrialsPerBlock: 40
            InterStimulusInterval: 1.5
      name: Working memory (N-Back)
      bounds:
        x: 350
        "y": 150
        width: 160
        height: 80

    Failed_NBack:
      type: bpmn:BoundaryEvent
      eventDefinitions:
        ErrorDef_Failed_NBack:
          type: bpmn:ErrorEventDefinition
      attachedToRef: Task_NBack
      cancelActivity: true
      bounds:
        x: 492
        "y": 212
        width: 36
        height: 36

    Task_DigitSpan:
      type: bpmn:Task
      extensionElements:
        - type: behaverse:Task
          scene: DS
      name: Verbal span (Digit Span)
      bounds:
        x: 350
        "y": 260
        width: 160
        height: 80

    Failed_DigitSpan:
      type: bpmn:BoundaryEvent
      eventDefinitions:
        ErrorDef_Failed_DigitSpan:
          type: bpmn:ErrorEventDefinition
      attachedToRef: Task_DigitSpan
      cancelActivity: true
      bounds:
        x: 492
        "y": 322
        width: 36
        height: 36

    Task_Flanker:
      type: bpmn:Task
      extensionElements:
        - type: cognitive:CognitiveTask
          instrument: jspsych
      name: Attention (Flanker)
      uses: https://github.com/jspsych/jspsych-contrib@v0.4.0#flanker
      bounds:
        x: 350
        "y": 370
        width: 160
        height: 80

    Failed_Flanker:
      type: bpmn:BoundaryEvent
      eventDefinitions:
        ErrorDef_Failed_Flanker:
          type: bpmn:ErrorEventDefinition
      attachedToRef: Task_Flanker
      cancelActivity: true
      bounds:
        x: 492
        "y": 432
        width: 36
        height: 36

    Task_SART:
      type: bpmn:Task
      extensionElements:
        - type: behaverse:Task
          scene: SART
      name: Sustained attention (SART)
      bounds:
        x: 350
        "y": 480
        width: 160
        height: 80

    Failed_SART:
      type: bpmn:BoundaryEvent
      eventDefinitions:
        ErrorDef_Failed_SART:
          type: bpmn:ErrorEventDefinition
      attachedToRef: Task_SART
      cancelActivity: true
      bounds:
        x: 492
        "y": 542
        width: 36
        height: 36

    Task_SRT:
      type: bpmn:Task
      extensionElements:
        - type: behaverse:Task
          scene: SRT
      name: Processing speed (Serial RT)
      bounds:
        x: 350
        "y": 590
        width: 160
        height: 80

    Failed_SRT:
      type: bpmn:BoundaryEvent
      eventDefinitions:
        ErrorDef_Failed_SRT:
          type: bpmn:ErrorEventDefinition
      attachedToRef: Task_SRT
      cancelActivity: true
      bounds:
        x: 492
        "y": 652
        width: 36
        height: 36

    Task_Matrices:
      type: bpmn:Task
      extensionElements:
        - type: behaverse:Task
          scene: BM
      name: Fluid reasoning (Belval Matrices)
      bounds:
        x: 350
        "y": 700
        width: 160
        height: 80

    Failed_Matrices:
      type: bpmn:BoundaryEvent
      eventDefinitions:
        ErrorDef_Failed_Matrices:
          type: bpmn:ErrorEventDefinition
      attachedToRef: Task_Matrices
      cancelActivity: true
      bounds:
        x: 492
        "y": 762
        width: 36
        height: 36

    Task_CardSorting:
      type: bpmn:Task
      extensionElements:
        - type: behaverse:Task
          scene: BCS
      name: Set-shifting (Belval Card Sorting)
      bounds:
        x: 350
        "y": 810
        width: 160
        height: 80

    Failed_CardSorting:
      type: bpmn:BoundaryEvent
      eventDefinitions:
        ErrorDef_Failed_CardSorting:
          type: bpmn:ErrorEventDefinition
      attachedToRef: Task_CardSorting
      cancelActivity: true
      bounds:
        x: 492
        "y": 872
        width: 36
        height: 36

    ErrEnd_FailedTrials:
      type: bpmn:EndEvent
      name: Failed-trial rate > 20% (any task)
      eventDefinitions:
        ErrorDef_FailedTrials:
          type: bpmn:ErrorEventDefinition
      bounds:
        x: 650
        "y": 430
        width: 36
        height: 36
      label:
        bounds:
          x: 628
          "y": 472
          width: 140
          height: 27
      stroke: "#ac5a54"
      fill: "#f1d0cd"
      background-color: "#f1d0cd"
      border-color: "#ac5a54"

    Battery_End:
      type: bpmn:EndEvent
      name: Battery completed
      bounds:
        x: 412
        "y": 920
        width: 36
        height: 36
      label:
        bounds:
          x: 456
          "y": 931
          width: 110
          height: 14

    Dataset_Trials:
      type: bpmn:DataStoreReference
      extensionElements:
        - type: studyflow:Dataset
          format: bdm
          bdmDataLevel: trials
      name: Trials (BDM)
      bounds:
        x: 235
        "y": 345
        width: 50
        height: 50
      label:
        bounds:
          x: 205
          "y": 400
          width: 110
          height: 14

    Schema_Trials:
      type: bpmn:DataObjectReference
      extensionElements:
        - type: studyflow:Schema
          format: csvw
      name: Trial schema (CSVW)
      dataObjectRef: DataObject_TrialSchema
      bounds:
        x: 242
        "y": 470
        width: 36
        height: 50
      label:
        bounds:
          x: 200
          "y": 525
          width: 120
          height: 27

    DataObject_TrialSchema:
      type: bpmn:DataObject

    Flow_BStart_NBack:
      type: bpmn:SequenceFlow
      sourceRef: Battery_Start
      targetRef: Task_NBack
      waypoint:
        - x: 430
          "y": 108
        - x: 430
          "y": 150
    Flow_NBack_DS:
      type: bpmn:SequenceFlow
      sourceRef: Task_NBack
      targetRef: Task_DigitSpan
      waypoint:
        - x: 430
          "y": 230
        - x: 430
          "y": 260
    Flow_DS_Flanker:
      type: bpmn:SequenceFlow
      sourceRef: Task_DigitSpan
      targetRef: Task_Flanker
      waypoint:
        - x: 430
          "y": 340
        - x: 430
          "y": 370
    Flow_Flanker_SART:
      type: bpmn:SequenceFlow
      sourceRef: Task_Flanker
      targetRef: Task_SART
      waypoint:
        - x: 430
          "y": 450
        - x: 430
          "y": 480
    Flow_SART_SRT:
      type: bpmn:SequenceFlow
      sourceRef: Task_SART
      targetRef: Task_SRT
      waypoint:
        - x: 430
          "y": 560
        - x: 430
          "y": 590
    Flow_SRT_Matrices:
      type: bpmn:SequenceFlow
      sourceRef: Task_SRT
      targetRef: Task_Matrices
      waypoint:
        - x: 430
          "y": 670
        - x: 430
          "y": 700
    Flow_Matrices_CardSort:
      type: bpmn:SequenceFlow
      sourceRef: Task_Matrices
      targetRef: Task_CardSorting
      waypoint:
        - x: 430
          "y": 780
        - x: 430
          "y": 810
    Flow_CardSort_BEnd:
      type: bpmn:SequenceFlow
      sourceRef: Task_CardSorting
      targetRef: Battery_End
      waypoint:
        - x: 430
          "y": 890
        - x: 430
          "y": 920

    Flow_Failed_NBack:
      type: bpmn:SequenceFlow
      sourceRef: Failed_NBack
      targetRef: ErrEnd_FailedTrials
      waypoint:
        - x: 528
          "y": 230
        - x: 600
          "y": 230
        - x: 600
          "y": 448
        - x: 650
          "y": 448
      stroke: "#ac5a54"
      border-color: "#ac5a54"
    Flow_Failed_DigitSpan:
      type: bpmn:SequenceFlow
      sourceRef: Failed_DigitSpan
      targetRef: ErrEnd_FailedTrials
      waypoint:
        - x: 528
          "y": 340
        - x: 600
          "y": 340
        - x: 600
          "y": 448
        - x: 650
          "y": 448
      stroke: "#ac5a54"
      border-color: "#ac5a54"
    Flow_Failed_Flanker:
      type: bpmn:SequenceFlow
      sourceRef: Failed_Flanker
      targetRef: ErrEnd_FailedTrials
      waypoint:
        - x: 528
          "y": 450
        - x: 600
          "y": 450
        - x: 600
          "y": 448
        - x: 650
          "y": 448
      stroke: "#ac5a54"
      border-color: "#ac5a54"
    Flow_Failed_SART:
      type: bpmn:SequenceFlow
      sourceRef: Failed_SART
      targetRef: ErrEnd_FailedTrials
      waypoint:
        - x: 528
          "y": 560
        - x: 600
          "y": 560
        - x: 600
          "y": 448
        - x: 650
          "y": 448
      stroke: "#ac5a54"
      border-color: "#ac5a54"
    Flow_Failed_SRT:
      type: bpmn:SequenceFlow
      sourceRef: Failed_SRT
      targetRef: ErrEnd_FailedTrials
      waypoint:
        - x: 528
          "y": 670
        - x: 600
          "y": 670
        - x: 600
          "y": 448
        - x: 650
          "y": 448
      stroke: "#ac5a54"
      border-color: "#ac5a54"
    Flow_Failed_Matrices:
      type: bpmn:SequenceFlow
      sourceRef: Failed_Matrices
      targetRef: ErrEnd_FailedTrials
      waypoint:
        - x: 528
          "y": 780
        - x: 600
          "y": 780
        - x: 600
          "y": 448
        - x: 650
          "y": 448
      stroke: "#ac5a54"
      border-color: "#ac5a54"
    Flow_Failed_CardSorting:
      type: bpmn:SequenceFlow
      sourceRef: Failed_CardSorting
      targetRef: ErrEnd_FailedTrials
      waypoint:
        - x: 528
          "y": 890
        - x: 600
          "y": 890
        - x: 600
          "y": 448
        - x: 650
          "y": 448
      stroke: "#ac5a54"
      border-color: "#ac5a54"

  artifacts:
    Assoc_NBack_Trials:
      type: bpmn:Association
      associationDirection: One
      sourceRef: Task_NBack
      targetRef: Dataset_Trials
      waypoint:
        - x: 350
          "y": 195
        - x: 285
          "y": 360
    Assoc_Flanker_Trials:
      type: bpmn:Association
      associationDirection: One
      sourceRef: Task_Flanker
      targetRef: Dataset_Trials
      waypoint:
        - x: 350
          "y": 405
        - x: 288
          "y": 393
    Assoc_Schema_Trials:
      type: bpmn:Association
      associationDirection: One
      sourceRef: Schema_Trials
      targetRef: Dataset_Trials
      waypoint:
        - x: 260
          "y": 470
        - x: 260
          "y": 395
