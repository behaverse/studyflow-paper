id: step04_report
definitions:
  targetNamespace: http://bpmn.io/schema/bpmn
  xmlns:xsi: http://www.w3.org/2001/XMLSchema-instance
  xmlns:bpmn2: http://www.omg.org/spec/BPMN/20100524/MODEL
  xmlns:studyflow: http://behaverse.org/schemas/studyflow/v1
  xmlns:datatrove: https://w3id.org/studyflow/datatrove

Report:
  type: bpmn:Process
  documentation: >-
    Step 4 of the example study: the report as a complete, runnable fragment.
    A render-and-write node turns the analysis outputs into the reporting
    artifacts, and a completion end event issues each actor's completion code.
    Everything else about reporting is a projection of the file itself: the
    Study, Gantt, Checklist, and Figure views, the CONSORT/SPIRIT/CHART
    guideline audits, and the deviation report (the diff between the
    registered file and the file after the run).
  extensionElements:
    - type: studyflow:Study
      runtime: browser
  name: Step 4 - Report
  isExecutable: true
  flowElements:

    Report_Start:
      type: bpmn:StartEvent
      name: Analysis outputs ready

    Render_Write:
      type: bpmn:ServiceTask
      extensionElements:
        - type: datatrove:Writer
          path: outputs/report/
      name: Render and write report
      isDataOperation: true
      uses: python://behaverse_analysis.render_report@1.0
      inputs:
        - group_stats
        - classifier_stats
      outputs:
        - report

    Complete:
      type: bpmn:EndEvent
      name: Completed
      redirectTo: https://app.prolific.com/submissions/complete?cc={COMPLETION_CODE}
      completionCodeType: dynamic

    Dataset_Summaries:
      type: bpmn:DataStoreReference
      extensionElements:
        - type: studyflow:Dataset
          format: bdm
          bdmDataLevel: models
      name: Summaries and statistics (BDM)

    Flow_Start_Render:
      type: bpmn:SequenceFlow
      sourceRef: Report_Start
      targetRef: Render_Write
    Flow_Render_Complete:
      type: bpmn:SequenceFlow
      sourceRef: Render_Write
      targetRef: Complete

  artifacts:
    Assoc_Summaries_Render:
      type: bpmn:Association
      associationDirection: One
      sourceRef: Dataset_Summaries
      targetRef: Render_Write
