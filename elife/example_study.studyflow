id: example_study
definitions:
  targetNamespace: http://bpmn.io/schema/bpmn
  xmlns:xsi: http://www.w3.org/2001/XMLSchema-instance
  xmlns:bpmn2: http://www.omg.org/spec/BPMN/20100524/MODEL
  xmlns:bpmndi: http://www.omg.org/spec/BPMN/20100524/DI
  xmlns:dc: http://www.omg.org/spec/DD/20100524/DC
  xmlns:di: http://www.omg.org/spec/DD/20100524/DI
  xmlns:bioc: http://bpmn.io/schema/bpmn/biocolor/1.0
  xmlns:color: http://www.omg.org/spec/BPMN/non-normative/color/1.0
  xmlns:studyflow: http://behaverse.org/schemas/studyflow/v1
  xmlns:cognitive: http://behaverse.org/schemas/studyflow/cognitive
  xmlns:behaverse: http://behaverse.org/schemas/studyflow/behaverse
  xmlns:datatrove: https://w3id.org/studyflow/datatrove

Example_Study_Collaboration:
  type: bpmn:Collaboration
  participants:
    Participant_Actor:
      name: Example study - one actor per run (human participant or artificial agent)
      processRef: Example_Study
      bounds:
        x: 150
        "y": 40
        width: 1240
        height: 3060
      isHorizontal: true

Example_Study:
  type: bpmn:Process
  documentation: >-
    Worked example study from the manuscript: a cognitive benchmark with the
    structure of a randomized controlled trial that enrolls, screens,
    allocates, administers, excludes, analyzes, and reports a single actor
    (human or artificial) through one interface. The lanes are the CONSORT
    phases (enrolment, allocation, follow-up, analysis); the battery and the
    analysis pipeline are expanded subprocesses; attrition is encoded as
    boundary error events terminating at counted error end events; and the
    analysis is a set of typed data-operation nodes fixed before the first run.
  extensionElements:
    - type: studyflow:Study
      runtime: browser
      # Study seed: with a subject identifier i, fixes each subject's path,
      # task order, stimulus order, and every random branch draw.
      seed: 42
  name: Example study (cognitive benchmark, human and artificial cohorts)
  isExecutable: true

  laneSets:
    LaneSet_Lifecycle:
      lanes:
        Lane_Enrolment:
          name: Enrolment
          flowNodeRef:
            - Enroll
            - Screening
            - Eligibility_Gateway
            - Excluded_Pre
          bounds:
            x: 180
            "y": 40
            width: 1210
            height: 320
          isHorizontal: true
        Lane_Allocation:
          name: Allocation
          flowNodeRef:
            - Randomize_Gateway
            - Allocate_Speeded
            - DidNotStart_Speeded
            - Allocate_SelfPaced
            - DidNotStart_SelfPaced
            - Merge_Allocation
          bounds:
            x: 180
            "y": 360
            width: 1210
            height: 320
          isHorizontal: true
        Lane_FollowUp:
          name: Follow-up
          flowNodeRef:
            - Battery
            - Battery_Error
            - Discontinued
          bounds:
            x: 180
            "y": 680
            width: 1210
            height: 1060
          isHorizontal: true
        Lane_Analysis:
          name: Analysis
          flowNodeRef:
            - Analysis
            - Render_Write
            - Complete
          bounds:
            x: 180
            "y": 1740
            width: 1210
            height: 1360
          isHorizontal: true

  flowElements:

    # ---------- Enrolment ----------
    Enroll:
      type: bpmn:StartEvent
      name: Enrolled and consented
      consentFormUri: https://behaverse.org/protocols/example-study/consent.md
      bounds:
        x: 542
        "y": 70
        width: 36
        height: 36
      label:
        bounds:
          x: 610
          "y": 75
          width: 90
          height: 27

    Screening:
      type: bpmn:Task
      extensionElements:
        - type: cognitive:Questionnaire
          instrument: screening
      checklist: |-
        - [ ] Informed consent recorded
        - [ ] Demographic intake
        - [ ] Inclusion criteria checked
        - [ ] Exclusion criteria checked
      name: Screening
      bounds:
        x: 480
        "y": 150
        width: 160
        height: 80

    Eligibility_Gateway:
      type: bpmn:ExclusiveGateway
      extensionElements:
        - type: cognitive:EligibilityGateway
          inclusionCriteria:
            - Aged 18 to 65 years (human cohort)
            - Normal or corrected-to-normal vision (human cohort)
            - Registered agent family with a pinned model version (artificial cohort)
          exclusionCriteria:
            - Prior exposure to the battery
            - Failed comprehension check at screening
      name: Assessed for eligibility
      isMarkerVisible: true
      bounds:
        x: 535
        "y": 265
        width: 50
        height: 50
      label:
        bounds:
          x: 395
          "y": 283
          width: 130
          height: 14

    Excluded_Pre:
      type: bpmn:EndEvent
      name: Excluded (n=...)
      eventDefinitions:
        ErrorDef_ExcludedPre:
          type: bpmn:ErrorEventDefinition
      bounds:
        x: 942
        "y": 272
        width: 36
        height: 36
      label:
        bounds:
          x: 890
          "y": 315
          width: 140
          height: 27
      stroke: "#ac5a54"
      fill: "#f1d0cd"
      background-color: "#f1d0cd"
      border-color: "#ac5a54"

    # ---------- Allocation (time-pressure condition) ----------
    Randomize_Gateway:
      type: bpmn:ExclusiveGateway
      extensionElements:
        - type: cognitive:RandomGateway
          algorithm: probabilistic
          probabilityFunction: uniform
      documentation: >-
        Random allocation applies to the human cohort only; artificial agents
        run the full factorial, so path contrasts hold within a family.
      name: Randomized
      isMarkerVisible: true
      bounds:
        x: 535
        "y": 395
        width: 50
        height: 50
      label:
        bounds:
          x: 380
          "y": 405
          width: 145
          height: 27

    Allocate_Speeded:
      type: bpmn:Task
      documentation: >-
        Time pressure is implemented per family: a response timeout for humans,
        a prompt deadline for language models.
      name: Allocated to speeded path (n=...)
      bounds:
        x: 300
        "y": 490
        width: 160
        height: 80

    DidNotStart_Speeded:
      type: bpmn:BoundaryEvent
      name: Did not receive allocated intervention (n=...)
      eventDefinitions:
        ErrorDef_DidNotStart_Speeded:
          type: bpmn:ErrorEventDefinition
      attachedToRef: Allocate_Speeded
      cancelActivity: true
      bounds:
        x: 322
        "y": 552
        width: 36
        height: 36
      label:
        bounds:
          x: 225
          "y": 585
          width: 110
          height: 14

    Allocate_SelfPaced:
      type: bpmn:Task
      documentation: >-
        Self-paced path: no response timeout for humans, no prompt deadline for
        language models.
      name: Allocated to self-paced path (n=...)
      bounds:
        x: 660
        "y": 490
        width: 160
        height: 80

    DidNotStart_SelfPaced:
      type: bpmn:BoundaryEvent
      name: Did not receive allocated intervention (n=...)
      eventDefinitions:
        ErrorDef_DidNotStart_SelfPaced:
          type: bpmn:ErrorEventDefinition
      attachedToRef: Allocate_SelfPaced
      cancelActivity: true
      bounds:
        x: 752
        "y": 552
        width: 36
        height: 36
      label:
        bounds:
          x: 795
          "y": 585
          width: 110
          height: 14

    Merge_Allocation:
      type: bpmn:ExclusiveGateway
      name: Begin battery
      bounds:
        x: 535
        "y": 610
        width: 50
        height: 50
      label:
        bounds:
          x: 600
          "y": 628
          width: 80
          height: 14

    # ---------- Follow-up: cognitive battery as an expanded subprocess ----------
    Battery:
      type: bpmn:SubProcess
      documentation: >-
        Six Behaverse tasks plus the jsPsych Flanker, administered one trial at
        a time. Each trial is an explicit subprocess compressed into the task's
        configurations payload. A run whose failed-trial rate exceeds 20% on
        any task raises an error that the subprocess boundary event propagates
        to the counted Discontinued exit.
      name: Cognitive battery (one trial at a time)
      isExpanded: true
      bounds:
        x: 330
        "y": 720
        width: 460
        height: 920
      flowElements:
        Battery_Start:
          type: bpmn:StartEvent
          bounds:
            x: 542
            "y": 750
            width: 36
            height: 36

        Task_NBack:
          type: bpmn:Task
          extensionElements:
            - type: behaverse:Task
              scene: NB
              # Compact view of the block config; the full Behaverse block structure
              # expands NValue, streams, and timing. InterStimulusInterval lives here once.
              configurations:
                NValue: 2
                TrialsPerBlock: 40
                InterStimulusInterval: 1.5
          name: Working memory (N-Back)
          bounds:
            x: 480
            "y": 820
            width: 160
            height: 80

        Failed_NBack:
          type: bpmn:BoundaryEvent
          name: Failed-trial rate > 20%
          eventDefinitions:
            ErrorDef_Failed_NBack:
              type: bpmn:ErrorEventDefinition
          attachedToRef: Task_NBack
          cancelActivity: true
          bounds:
            x: 622
            "y": 842
            width: 36
            height: 36

        Task_DigitSpan:
          type: bpmn:Task
          extensionElements:
            - type: behaverse:Task
              scene: DS
          name: Verbal span (Digit Span)
          bounds:
            x: 480
            "y": 930
            width: 160
            height: 80

        Task_Flanker:
          type: bpmn:Task
          extensionElements:
            - type: cognitive:CognitiveTask
              instrument: jspsych
          name: Attention (Flanker)
          uses: https://github.com/jspsych/jspsych-contrib@v0.4.0#flanker
          bounds:
            x: 480
            "y": 1040
            width: 160
            height: 80

        Failed_Flanker:
          type: bpmn:BoundaryEvent
          name: Failed-trial rate > 20%
          eventDefinitions:
            ErrorDef_Failed_Flanker:
              type: bpmn:ErrorEventDefinition
          attachedToRef: Task_Flanker
          cancelActivity: true
          bounds:
            x: 622
            "y": 1062
            width: 36
            height: 36

        Task_SART:
          type: bpmn:Task
          extensionElements:
            - type: behaverse:Task
              scene: SART
          name: Sustained attention (SART)
          bounds:
            x: 480
            "y": 1150
            width: 160
            height: 80

        Task_SRT:
          type: bpmn:Task
          extensionElements:
            - type: behaverse:Task
              scene: SRT
          name: Processing speed (Serial RT)
          bounds:
            x: 480
            "y": 1260
            width: 160
            height: 80

        Task_Matrices:
          type: bpmn:Task
          extensionElements:
            - type: behaverse:Task
              scene: BM
          name: Fluid reasoning (Belval Matrices)
          bounds:
            x: 480
            "y": 1370
            width: 160
            height: 80

        Task_CardSorting:
          type: bpmn:Task
          extensionElements:
            - type: behaverse:Task
              scene: BCS
          name: Set-shifting (Belval Card Sorting)
          bounds:
            x: 480
            "y": 1480
            width: 160
            height: 80

        ErrEnd_FailedTrials:
          type: bpmn:EndEvent
          name: Failed-trial rate > 20%
          eventDefinitions:
            ErrorDef_FailedTrials:
              type: bpmn:ErrorEventDefinition
          bounds:
            x: 690
            "y": 952
            width: 36
            height: 36
          label:
            bounds:
              x: 640
              "y": 995
              width: 140
              height: 27
          stroke: "#ac5a54"
          fill: "#f1d0cd"
          background-color: "#f1d0cd"
          border-color: "#ac5a54"

        Battery_End:
          type: bpmn:EndEvent
          name: Battery completed
          bounds:
            x: 542
            "y": 1585
            width: 36
            height: 36
          label:
            bounds:
              x: 590
              "y": 1596
              width: 110
              height: 14

        # Inner sequence flows of the battery
        Flow_BStart_NBack:
          type: bpmn:SequenceFlow
          sourceRef: Battery_Start
          targetRef: Task_NBack
          waypoint:
            - x: 560
              "y": 786
            - x: 560
              "y": 820
        Flow_NBack_DS:
          type: bpmn:SequenceFlow
          sourceRef: Task_NBack
          targetRef: Task_DigitSpan
          waypoint:
            - x: 560
              "y": 900
            - x: 560
              "y": 930
        Flow_DS_Flanker:
          type: bpmn:SequenceFlow
          sourceRef: Task_DigitSpan
          targetRef: Task_Flanker
          waypoint:
            - x: 560
              "y": 1010
            - x: 560
              "y": 1040
        Flow_Flanker_SART:
          type: bpmn:SequenceFlow
          sourceRef: Task_Flanker
          targetRef: Task_SART
          waypoint:
            - x: 560
              "y": 1120
            - x: 560
              "y": 1150
        Flow_SART_SRT:
          type: bpmn:SequenceFlow
          sourceRef: Task_SART
          targetRef: Task_SRT
          waypoint:
            - x: 560
              "y": 1230
            - x: 560
              "y": 1260
        Flow_SRT_Matrices:
          type: bpmn:SequenceFlow
          sourceRef: Task_SRT
          targetRef: Task_Matrices
          waypoint:
            - x: 560
              "y": 1340
            - x: 560
              "y": 1370
        Flow_Matrices_CardSort:
          type: bpmn:SequenceFlow
          sourceRef: Task_Matrices
          targetRef: Task_CardSorting
          waypoint:
            - x: 560
              "y": 1450
            - x: 560
              "y": 1480
        Flow_CardSort_BEnd:
          type: bpmn:SequenceFlow
          sourceRef: Task_CardSorting
          targetRef: Battery_End
          waypoint:
            - x: 560
              "y": 1560
            - x: 560
              "y": 1585
        Flow_Failed_NBack:
          type: bpmn:SequenceFlow
          sourceRef: Failed_NBack
          targetRef: ErrEnd_FailedTrials
          waypoint:
            - x: 658
              "y": 860
            - x: 708
              "y": 860
            - x: 708
              "y": 952
        Flow_Failed_Flanker:
          type: bpmn:SequenceFlow
          sourceRef: Failed_Flanker
          targetRef: ErrEnd_FailedTrials
          waypoint:
            - x: 658
              "y": 1080
            - x: 708
              "y": 1080
            - x: 708
              "y": 988

    Battery_Error:
      type: bpmn:BoundaryEvent
      name: battery exit
      eventDefinitions:
        ErrorDef_BatteryExit:
          type: bpmn:ErrorEventDefinition
      attachedToRef: Battery
      cancelActivity: true
      bounds:
        x: 772
        "y": 1162
        width: 36
        height: 36
      label:
        bounds:
          x: 798
          "y": 1140
          width: 80
          height: 14

    Discontinued:
      type: bpmn:EndEvent
      name: Discontinued intervention (n=...)
      eventDefinitions:
        ErrorDef_Discontinued:
          type: bpmn:ErrorEventDefinition
      bounds:
        x: 942
        "y": 1162
        width: 36
        height: 36
      label:
        bounds:
          x: 890
          "y": 1205
          width: 140
          height: 27
      stroke: "#ac5a54"
      fill: "#f1d0cd"
      background-color: "#f1d0cd"
      border-color: "#ac5a54"

    # ---------- Data elements and contracts ----------
    Dataset_Trials:
      type: bpmn:DataStoreReference
      extensionElements:
        - type: studyflow:Dataset
          format: bdm
          bdmDataLevel: trials
      name: Trials (BDM)
      bounds:
        x: 935
        "y": 880
        width: 50
        height: 50
      label:
        bounds:
          x: 905
          "y": 935
          width: 110
          height: 14

    Schema_Trials:
      type: bpmn:DataObjectReference
      extensionElements:
        - type: studyflow:Schema
          format: csvw
      name: Trial schema (CSVW)
      dataObjectRef: DataObject_TrialSchema
      bounds:
        x: 1072
        "y": 880
        width: 36
        height: 50
      label:
        bounds:
          x: 1030
          "y": 935
          width: 120
          height: 27

    DataObject_TrialSchema:
      type: bpmn:DataObject

    Dataset_Summaries:
      type: bpmn:DataStoreReference
      extensionElements:
        - type: studyflow:Dataset
          format: bdm
          bdmDataLevel: models
      name: Summaries and statistics (BDM)
      bounds:
        x: 935
        "y": 2430
        width: 50
        height: 50
      label:
        bounds:
          x: 900
          "y": 2485
          width: 120
          height: 27

    # ---------- Analysis: the pipeline as an expanded subprocess ----------
    Analysis:
      type: bpmn:SubProcess
      documentation: >-
        The preregistered analysis pipeline: typed data-operation nodes fixed
        before the first run. Read, filter (the analysis exclusion the CONSORT
        flow reports), map to derived measures, branch on the comparison of
        interest, reduce in two stages, and a manual outlier review before the
        final write. Each step delegates through a versioned `uses` reference.
      name: Analysis pipeline (registered before the first run)
      isExpanded: true
      bounds:
        x: 300
        "y": 1780
        width: 560
        height: 980
      flowElements:
        Analysis_Start:
          type: bpmn:StartEvent
          bounds:
            x: 542
            "y": 1810
            width: 36
            height: 36

        Read:
          type: bpmn:ServiceTask
          extensionElements:
            - type: datatrove:Reader
          name: Read raw trials
          isDataOperation: true
          uses: python://behaverse_analysis.read_trials@1.0
          outputs:
            - trials
          bounds:
            x: 480
            "y": 1880
            width: 160
            height: 80

        Filter:
          type: bpmn:ServiceTask
          extensionElements:
            - type: datatrove:Filter
          name: Filter invalid trials (analysis exclusion)
          isDataOperation: true
          uses: python://behaverse_analysis.filter_invalid@1.0
          with:
            min_rt_ms: 100
            drop_missing: true
            drop_flagged: true
          inputs:
            - trials
          outputs:
            - valid_trials
          bounds:
            x: 480
            "y": 1990
            width: 160
            height: 80

        # The analysis exclusion the CONSORT flow reports: runs dropped at the
        # filter step leave through a counted error end, mirroring the enrolment
        # and follow-up attrition exits.
        ExclFromAnalysis:
          type: bpmn:BoundaryEvent
          name: analysis exclusion
          eventDefinitions:
            ErrorDef_ExclFromAnalysis:
              type: bpmn:ErrorEventDefinition
          attachedToRef: Filter
          cancelActivity: true
          bounds:
            x: 622
            "y": 2052
            width: 36
            height: 36

        Excluded_Analysis:
          type: bpmn:EndEvent
          name: Excluded from analysis (n=...)
          eventDefinitions:
            ErrorDef_ExcludedAnalysis:
              type: bpmn:ErrorEventDefinition
          bounds:
            x: 760
            "y": 2020
            width: 36
            height: 36
          label:
            bounds:
              x: 720
              "y": 2060
              width: 130
              height: 27
          stroke: "#ac5a54"
          fill: "#f1d0cd"
          background-color: "#f1d0cd"
          border-color: "#ac5a54"

        Map:
          type: bpmn:ServiceTask
          extensionElements:
            - type: datatrove:Map
          name: Map to derived measures
          isDataOperation: true
          uses: python://behaverse_analysis.derive_measures@1.0
          inputs:
            - valid_trials
          outputs:
            - measures
          bounds:
            x: 480
            "y": 2100
            width: 160
            height: 80

        Branch_Comparison:
          type: bpmn:ExclusiveGateway
          name: Comparison of interest
          bounds:
            x: 535
            "y": 2210
            width: 50
            height: 50
          label:
            bounds:
              x: 595
              "y": 2223
              width: 130
              height: 14

        Reduce_Subject:
          type: bpmn:ServiceTask
          extensionElements:
            - type: datatrove:Reduce
          name: Reduce to per-run summaries
          isDataOperation: true
          uses: python://behaverse_analysis.summarize_runs@1.0
          inputs:
            - measures
          outputs:
            - run_summaries
          bounds:
            x: 340
            "y": 2300
            width: 160
            height: 80

        Reduce_Group:
          type: bpmn:ServiceTask
          extensionElements:
            - type: datatrove:Reduce
          name: Reduce to group statistics (marker, agreement)
          isDataOperation: true
          uses: python://behaverse_analysis.group_stats@1.0
          inputs:
            - run_summaries
          outputs:
            - group_stats
          bounds:
            x: 340
            "y": 2410
            width: 160
            height: 80

        Outlier_Review:
          type: bpmn:UserTask
          name: Manual outlier review
          bounds:
            x: 340
            "y": 2520
            width: 160
            height: 80

        Classifier:
          type: bpmn:ServiceTask
          extensionElements:
            - type: datatrove:Transform
              operationType: fit
          name: Train divergence classifier (distinguishability)
          isDataOperation: true
          uses: python://behaverse_analysis.train_classifier@1.0
          inputs:
            - measures
          outputs:
            - classifier_stats
          bounds:
            x: 640
            "y": 2300
            width: 160
            height: 80

        Merge_Analysis:
          type: bpmn:ExclusiveGateway
          name: Collect outputs
          bounds:
            x: 535
            "y": 2630
            width: 50
            height: 50
          label:
            bounds:
              x: 600
              "y": 2648
              width: 90
              height: 14

        Analysis_End:
          type: bpmn:EndEvent
          bounds:
            x: 542
            "y": 2700
            width: 36
            height: 36

        # Inner sequence flows of the analysis pipeline
        Flow_AStart_Read:
          type: bpmn:SequenceFlow
          sourceRef: Analysis_Start
          targetRef: Read
          waypoint:
            - x: 560
              "y": 1846
            - x: 560
              "y": 1880
        Flow_Read_Filter:
          type: bpmn:SequenceFlow
          sourceRef: Read
          targetRef: Filter
          waypoint:
            - x: 560
              "y": 1960
            - x: 560
              "y": 1990
        Flow_Filter_Map:
          type: bpmn:SequenceFlow
          sourceRef: Filter
          targetRef: Map
          waypoint:
            - x: 560
              "y": 2070
            - x: 560
              "y": 2100
        Flow_ExclFromAnalysis:
          type: bpmn:SequenceFlow
          sourceRef: ExclFromAnalysis
          targetRef: Excluded_Analysis
          waypoint:
            - x: 640
              "y": 2070
            - x: 778
              "y": 2070
            - x: 778
              "y": 2056
          stroke: "#ac5a54"
          border-color: "#ac5a54"
        Flow_Map_Branch:
          type: bpmn:SequenceFlow
          sourceRef: Map
          targetRef: Branch_Comparison
          waypoint:
            - x: 560
              "y": 2180
            - x: 560
              "y": 2210
        Flow_Branch_ReduceSubject:
          type: bpmn:SequenceFlow
          name: agreement / marker
          sourceRef: Branch_Comparison
          targetRef: Reduce_Subject
          waypoint:
            - x: 535
              "y": 2235
            - x: 420
              "y": 2235
            - x: 420
              "y": 2300
          label:
            bounds:
              x: 305
              "y": 2245
              width: 110
              height: 27
        Flow_Branch_Classifier:
          type: bpmn:SequenceFlow
          name: divergence
          sourceRef: Branch_Comparison
          targetRef: Classifier
          waypoint:
            - x: 585
              "y": 2235
            - x: 720
              "y": 2235
            - x: 720
              "y": 2300
          label:
            bounds:
              x: 728
              "y": 2245
              width: 66
              height: 14
        Flow_ReduceSubject_Group:
          type: bpmn:SequenceFlow
          sourceRef: Reduce_Subject
          targetRef: Reduce_Group
          waypoint:
            - x: 420
              "y": 2380
            - x: 420
              "y": 2410
        Flow_Group_Outlier:
          type: bpmn:SequenceFlow
          sourceRef: Reduce_Group
          targetRef: Outlier_Review
          waypoint:
            - x: 420
              "y": 2490
            - x: 420
              "y": 2520
        Flow_Outlier_Merge:
          type: bpmn:SequenceFlow
          sourceRef: Outlier_Review
          targetRef: Merge_Analysis
          waypoint:
            - x: 420
              "y": 2600
            - x: 420
              "y": 2655
            - x: 535
              "y": 2655
        Flow_Classifier_Merge:
          type: bpmn:SequenceFlow
          sourceRef: Classifier
          targetRef: Merge_Analysis
          waypoint:
            - x: 720
              "y": 2380
            - x: 720
              "y": 2655
            - x: 585
              "y": 2655
        Flow_Merge_AEnd:
          type: bpmn:SequenceFlow
          sourceRef: Merge_Analysis
          targetRef: Analysis_End
          waypoint:
            - x: 560
              "y": 2680
            - x: 560
              "y": 2700

    Render_Write:
      type: bpmn:ServiceTask
      extensionElements:
        - type: datatrove:Writer
          path: outputs/report/
      name: Render and write report
      isDataOperation: true
      uses: python://behaverse_analysis.render_report@1.0
      inputs:
        - group_stats
        - classifier_stats
      outputs:
        - report
      bounds:
        x: 480
        "y": 2820
        width: 160
        height: 80

    Complete:
      type: bpmn:EndEvent
      name: Completed
      redirectTo: https://app.prolific.com/submissions/complete?cc={COMPLETION_CODE}
